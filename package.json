{
  "name": "questionpapers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:app": "next build",
    "start": "next start",
    "lint": "eslint",
    "manifest": "node scripts/generate-papers-manifest.cjs",
    "papers:sync": "node scripts/sync-authoritative-papers.mjs",
    "papers:ocr": "node scripts/generate-editable-papers.mjs",
    "repeat:prepare": "python3 scripts/build-repeat-v2.py prepare --concurrency 6",
    "repeat:ocr": "python3 scripts/build-repeat-v2.py vision --concurrency 8 && python3 scripts/finalize-repeat-v2.py",
    "repeat:finalize": "python3 scripts/finalize-repeat-v2.py",
    "repeat:optimize": "python3 scripts/optimize-repeat-assets.py",
    "repeat:validate": "python3 scripts/build-repeat-v2.py validate && node scripts/validate-repeat-v2-math.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:setup-auth": "node scripts/setup-convex-auth.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@base-ui/react": "^1.2.0",
    "@convex-dev/auth": "^0.0.95",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.101.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.45.0",
    "cytoscape": "^3.33.2",
    "cytoscape-dagre": "^2.5.0",
    "date-fns": "^4.1.0",
    "dodopayments": "^2.49.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "katex": "^0.16.44",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.6.205",
    "posthog-js": "^1.418.16",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
