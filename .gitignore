# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/generated/

# production
/build

# misc
.DS_Store
*.pem
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python OCR caches and local environments
__pycache__/
*.pyc
.venv/

# Hosted study assets are referenced by lib/convex-asset-map.json.
/public/repeat-v2/assets/
/public/midsem/figures/
/public/midsem/**/*.pdf
/public/midsem/*.pdf
/public/midsem/*.zip

# Local build, upload, and deduplication state.
/.codex-tmp/
/tmp/
/output/duplicate-pdfs/
/output/convex-assets-checkpoint.jsonl
/output/vercel-release-path.txt
/output/pdf/latex-papers/**/*.log
/output/pdf/latex-papers/**/*.build.txt
