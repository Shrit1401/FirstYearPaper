{"id":"m2-l1","title":"Arithmetic circuits","aspect":0.5625,"wpt":960,"slides":[{"bg":null,"items":[{"t":"text","box":[0.3294,0.085,0.3252,0.0853],"paras":[{"runs":[{"text":"ARITHMETIC CIRCUITS","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.0654,0.2004,0.5192,0.0853],"paras":[{"runs":[{"text":"Addition of Unsigned Numbers ","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.0933,0.3156,0.7799,0.1571],"paras":[{"runs":[{"text":"The one-bit addition entails four possible combinations, ","sz":32.0}],"align":"just"}],"anchor":"t"},{"t":"img","box":[0.3267,0.4726,0.5296,0.4427],"src":"/dsco/slides/m2-l1/1.webp"}]},{"bg":null,"items":[{"t":"img","box":[0.0437,0.0899,0.3358,0.5833],"src":"/dsco/slides/m2-l1/2.webp"},{"t":"img","box":[0.3929,0.1961,0.5742,0.3709],"src":"/dsco/slides/m2-l1/3.webp"},{"t":"text","box":[0.0437,0.6433,0.9235,0.3007],"paras":[{"runs":[{"text":"The sum bit ","sz":32.0},{"text":"s ","sz":32.0,"i":1},{"text":"is the XOR function. The carry ","sz":32.0},{"text":"c ","sz":32.0,"i":1},{"text":"is the AND function of inputs ","sz":32.0},{"text":"x ","sz":32.0,"i":1},{"text":"and ","sz":32.0},{"text":"y","sz":32.0,"i":1},{"text":". A circuit realization of these functions is shown in Fig. ","sz":32.0},{"text":"c","sz":32.0,"i":1},{"text":". This circuit, which implements the addition of only two bits, is called a ","sz":32.0},{"text":"half-adder","sz":32.0,"i":1},{"text":".","sz":32.0}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"img","box":[0.1546,0.3258,0.6521,0.3772],"src":"/dsco/slides/m2-l1/4.webp"},{"t":"text","box":[0.0918,0.1075,0.2573,0.0853],"paras":[{"runs":[{"text":"Multibit Addition","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.1078,0.7613,0.7776,0.1571],"paras":[{"runs":[{"text":"for each bit position ","sz":32.0},{"text":"i","sz":32.0,"i":1},{"text":", the addition operation may include a ","sz":32.0},{"text":"carry-in ","sz":32.0,"i":1},{"text":"from bit position ","sz":32.0},{"text":"i","sz":32.0,"i":1},{"text":" ","sz":32.0,"i":1},{"text":"\u2212 ","sz":32.0},{"text":"1.","sz":32.0}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"img","box":[0.1638,0.1063,0.6556,0.0967],"src":"/dsco/slides/m2-l1/5.webp"},{"t":"img","box":[0.1509,0.2268,0.6875,0.4564],"src":"/dsco/slides/m2-l1/6.webp"},{"t":"img","box":[0.1638,0.7069,0.3657,0.1324],"src":"/dsco/slides/m2-l1/7.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0653,0.0725,0.856,0.2289],"paras":[{"runs":[{"text":"This observation leads to the design of a logic circuit that","sz":32.0}],"align":"just"},{"runs":[{"text":"has three inputs ","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"i ","sz":32.0,"i":1,"sub":1},{"text":", ","sz":32.0},{"text":"y","sz":32.0,"i":1},{"text":"i","sz":32.0,"i":1,"sub":1},{"text":" ","sz":32.0,"i":1,"sub":1},{"text":", and ","sz":32.0},{"text":"c","sz":32.0,"i":1},{"text":"i ","sz":32.0,"i":1,"sub":1},{"text":", and produces the two outputs ","sz":32.0},{"text":"s","sz":32.0,"i":1},{"text":"i","sz":32.0,"i":1,"sub":1},{"text":" ","sz":32.0,"i":1,"sub":1},{"text":"and ","sz":32.0},{"text":"c","sz":32.0,"i":1},{"text":"i","sz":32.0,"i":1,"sub":1},{"text":"+","sz":32.0,"sub":1},{"text":"1","sz":32.0,"sub":1},{"text":".","sz":32.0}],"align":"just"}],"anchor":"t"},{"t":"img","box":[0.0854,0.3627,0.2628,0.544],"src":"/dsco/slides/m2-l1/8.webp"},{"t":"img","box":[0.3607,0.3959,0.2493,0.3535],"src":"/dsco/slides/m2-l1/9.webp"},{"t":"img","box":[0.6426,0.3959,0.2787,0.3762],"src":"/dsco/slides/m2-l1/10.webp"}]},{"bg":null,"items":[{"t":"img","box":[0.1097,0.1024,0.4836,0.7557],"src":"/dsco/slides/m2-l1/11.webp"},{"t":"text","box":[0.6403,0.4311,0.3134,0.1571],"paras":[{"runs":[{"text":"This circuit is known as a ","sz":32.0},{"text":"full-adder","sz":32.0,"i":1},{"text":".","sz":32.0}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0825,0.0611,0.3222,0.0853],"paras":[{"runs":[{"text":"Ripple-Carry Adder","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"img","box":[0.05,0.2141,0.8422,0.5668],"src":"/dsco/slides/m2-l1/12.webp"},{"t":"text","box":[0.1034,0.7812,0.8134,0.1571],"paras":[{"runs":[{"text":"For each bit position we can use a full-adder circuit, connected as shown in Figure","sz":32.0}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0739,0.0599,0.8082,0.8931],"paras":[{"runs":[{"text":"When the operands ","sz":28.0},{"text":"X ","sz":28.0,"i":1},{"text":"and ","sz":28.0},{"text":"Y ","sz":28.0,"i":1},{"text":"are applied as inputs to the adder, it takes some time before the output sum, ","sz":28.0},{"text":"S","sz":28.0,"i":1},{"text":", is valid. Each full-adder introduces a certain delay before its ","sz":28.0},{"text":"s","sz":28.0,"i":1},{"text":"i","sz":28.0,"i":1,"sub":1},{"text":" ","sz":28.0,"i":1,"sub":1},{"text":"and ","sz":28.0},{"text":"c","sz":28.0,"i":1},{"text":"i","sz":28.0,"i":1,"sub":1},{"text":"+","sz":28.0,"sub":1},{"text":"1","sz":28.0,"sub":1},{"text":" ","sz":28.0},{"text":"outputs are valid. Let this delay be denoted as ","sz":28.0},{"text":"\u2206","sz":28.0},{"text":"t","sz":28.0,"i":1},{"text":". ","sz":28.0}],"align":"just","bullet":1},{"runs":[{"text":"Thus the carry-out from the first stage, ","sz":28.0},{"text":"c","sz":28.0,"i":1},{"text":"1","sz":28.0,"sub":1},{"text":", arrives at the second stage ","sz":28.0},{"text":"\u2206","sz":28.0},{"text":"t ","sz":28.0,"i":1},{"text":"after the application of the ","sz":28.0},{"text":"x","sz":28.0,"i":1},{"text":"0 ","sz":28.0,"sub":1},{"text":"and ","sz":28.0},{"text":"y","sz":28.0,"i":1},{"text":"0 ","sz":28.0,"sub":1},{"text":"inputs. The carry-out from the second stage, ","sz":28.0},{"text":"c","sz":28.0,"i":1},{"text":"2","sz":28.0,"sub":1},{"text":", arrives at the third stage with a 2","sz":28.0},{"text":"\u2206","sz":28.0},{"text":"t ","sz":28.0,"i":1},{"text":"delay, and so on. ","sz":28.0}],"align":"just","bullet":1},{"runs":[{"text":"The signal ","sz":28.0},{"text":"c","sz":28.0,"i":1},{"text":"n","sz":28.0,"i":1,"sub":1},{"text":"\u2212","sz":28.0,"sub":1},{"text":"1 ","sz":28.0,"sub":1},{"text":"is valid after a delay of ","sz":28.0},{"text":"(","sz":28.0,"i":1},{"text":"n ","sz":28.0,"i":1},{"text":"\u2212 ","sz":28.0},{"text":"1","sz":28.0},{"text":")","sz":28.0,"i":1},{"text":" \u2206","sz":28.0},{"text":"t","sz":28.0,"i":1},{"text":", which means that the complete sum is available after a delay of ","sz":28.0},{"text":"n","sz":28.0},{"text":"\u2206","sz":28.0},{"text":"t","sz":28.0},{"text":". Because of the way the carry signals \u201cripple\u201d through the full-adder stages, the circuit is called a ripple-carry adder.","sz":28.0}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.101,0.079,0.4354,0.0853],"paras":[{"runs":[{"text":"Adder and ","sz":32.0,"b":1},{"text":"Subtractor","sz":32.0,"b":1},{"text":" Unit","sz":32.0,"b":1}],"align":"just"}],"anchor":"t"},{"t":"img","box":[0.019,0.1874,0.7332,0.7335],"src":"/dsco/slides/m2-l1/13.webp"},{"t":"img","box":[0.7063,0.5923,0.2485,0.3676],"src":"/dsco/slides/m2-l1/14.webp","crop":[0.67498,0.0,0.05485,0.19842]},{"t":"text","box":[0.8778,0.6806,0.0771,0.0539],"paras":[{"runs":[{"text":"A XOR B","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.2015,0.1791,0.5254,0.3725],"paras":[{"runs":[{"text":"When Add/Sub = 0, it performs ","sz":32.0},{"text":"X + Y","sz":32.0,"b":1},{"text":".","sz":32.0}]},{"runs":[{"text":"When Add/Sub = 1, it performs ","sz":32.0}]},{"runs":[{"text":"   X + Y\u2019 + 1","sz":32.0,"b":1},{"text":" ","sz":32.0}]},{"runs":[{"text":"= ","sz":32.0},{"text":"X + 2\u2019s complement of Y ","sz":32.0,"b":1}]},{"runs":[{"text":"= ","sz":32.0},{"text":"X - Y","sz":32.0,"b":1}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.2737,0.0771,0.4225,0.0853],"paras":[{"runs":[{"text":"Hierarchical Verilog Code","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.1112,0.3605,0.819,0.3007],"paras":[{"runs":[{"text":"For larger designs, it is often convenient to create a hierarchical structure in the Verilog code, in which there is a ","sz":32.0},{"text":"top-level ","sz":32.0,"i":1},{"text":"module that includes multiple instances of ","sz":32.0},{"text":"lower-level ","sz":32.0,"i":1},{"text":"modules.","sz":32.0}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"img","box":[0.1151,0.1095,0.727,0.5072],"src":"/dsco/slides/m2-l1/15.webp"},{"t":"text","box":[0.1433,0.7065,0.1165,0.0853],"paras":[{"runs":[{"text":"Let n=4","sz":32.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"table","box":[0.0651,0.036,0.878,0.9164],"rows":[[{"text":"module adder4 (carryin, x3, x2, x1, x0, y3, y2, y1, y0, s3, s2, s1, s0, carryout); input carryin, x3, x2, x1, x0, y3, y2, y1, y0; output s3, s2, s1, s0, carryout; fulladd stage0 (carryin, x0, y0, s0, c1); fulladd stage1 (c1, x1, y1, s1, c2); fulladd stage2 (c2, x2, y2, s2, c3); fulladd stage3 (c3, x3, y3, s3, carryout); endmodule \u00a0 module fulladd (Cin, x, y, s, Cout); input Cin, x, y; output s, Cout; assign s = x \u2227 y \u2227 Cin; assign Cout = (x & y) | (x & Cin) | (y & Cin); endmodule","span":1,"rows":1,"fill":null}]]}]},{"bg":null,"items":[{"t":"table","box":[0.0828,0.4891,0.8328,0.1588],"rows":[[{"text":"module_name  instance_name (.port_name ( [expression] ) {, .port_name ( [expression] )} );","span":1,"rows":1,"fill":null}]]},{"t":"text","box":[0.1017,0.1134,0.814,0.3007],"paras":[{"runs":[{"text":"A Verilog module can be included as a ","sz":32.0},{"text":"subcircuit","sz":32.0},{"text":" in another module. ","sz":32.0}],"align":"just","bullet":1},{"runs":[{"text":"The general form of a module instantiation statement is given below.","sz":32.0}],"align":"just","bullet":1}],"anchor":"ctr"}]},{"bg":null,"items":[{"t":"text","box":[0.0828,0.1403,0.7791,0.6741],"paras":[{"runs":[{"text":"The ","sz":32.0},{"text":"instance_name","sz":32.0,"b":1,"i":1},{"text":" can be any legal Verilog identifier and the port connections specify how the module is connected to the rest of the circuit. ","sz":32.0}],"align":"just","bullet":1},{"runs":[{"text":"The same module can be instantiated multiple times in a given design provided that each instance name is unique.","sz":32.0}],"align":"just","bullet":1},{"runs":[{"text":"Each ","sz":32.0},{"text":"port_name","sz":32.0},{"text":" is the name of a port in the ","sz":32.0},{"text":"subcircuit","sz":32.0},{"text":", and each expression specifies a connection to that port.","sz":32.0}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.1097,0.0985,0.806,0.6741],"paras":[{"runs":[{"text":"Named port connections","sz":32.0,"b":1},{"text":" -The syntax  .","sz":32.0},{"text":"port_name","sz":32.0},{"text":" is provided so that the order of signals listed in the instantiation statement does not have to be the same as the order of the ports given in the module statement of the ","sz":32.0},{"text":"subcircuit","sz":32.0},{"text":". ","sz":32.0}],"align":"just","bullet":1},{"runs":[{"text":"Ordered port connections","sz":32.0,"b":1},{"text":"-If the port connections are given in the same order as in the ","sz":32.0},{"text":"subcircuit","sz":32.0},{"text":", then  .","sz":32.0},{"text":"port_name","sz":32.0},{"text":" is not needed.","sz":32.0}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0951,0.0972,0.7646,0.736],"paras":[{"runs":[{"text":"Using Vectored Signals","sz":28.0,"b":1}]},{"runs":[{"text":"Multibit signals are called ","sz":28.0},{"text":"vectors","sz":28.0,"i":1},{"text":".","sz":28.0}],"align":"just","bullet":1},{"runs":[{"text":" An example of an input vector is","sz":28.0}],"align":"just","bullet":1},{"runs":[{"text":"input ","sz":28.0,"b":1},{"text":"[3:0] W;","sz":28.0}],"align":"just"},{"runs":[{"text":"This statement defines ","sz":28.0},{"text":"W ","sz":28.0,"i":1},{"text":"to be a four-bit vector. Its individual bits can be referred to using an index value in square brackets.  ","sz":28.0}],"align":"just","bullet":1},{"runs":[{"text":"The most-significant bit (MSB) is referred to as ","sz":28.0},{"text":"W","sz":28.0,"i":1},{"text":"[3] and the least-significant bit (LSB) is ","sz":28.0},{"text":"W","sz":28.0,"i":1},{"text":"[0].","sz":28.0}],"align":"just","bullet":1},{"runs":[{"text":"input ","sz":28.0,"b":1},{"text":"[0:3] W; Here ","sz":28.0},{"text":"W","sz":28.0,"i":1},{"text":"[0] is MSB and ","sz":28.0},{"text":"W","sz":28.0,"i":1},{"text":"[3] LSB ","sz":28.0}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0616,0.1395,0.9011,0.7046],"paras":[{"runs":[{"text":"module ","sz":28.0,"b":1},{"text":"adder4 (","sz":28.0},{"text":"carryin","sz":28.0},{"text":", X, Y, S, carryout);","sz":28.0}]},{"runs":[{"text":"input ","sz":28.0,"b":1},{"text":"carryin","sz":28.0},{"text":";","sz":28.0}]},{"runs":[{"text":"input ","sz":28.0,"b":1},{"text":"[3:0] X, Y;","sz":28.0}]},{"runs":[{"text":"output ","sz":28.0,"b":1},{"text":"[3:0] S;","sz":28.0}]},{"runs":[{"text":"output ","sz":28.0,"b":1},{"text":"carryout;","sz":28.0}]},{"runs":[{"text":"wire ","sz":28.0,"b":1},{"text":"[3:1] C;","sz":28.0}]},{"runs":[{"text":"fulladd","sz":28.0},{"text":" stage0 (","sz":28.0},{"text":"carryin","sz":28.0},{"text":", X[0], Y[0], S[0], C[1]);","sz":28.0}]},{"runs":[{"text":"fulladd","sz":28.0},{"text":" stage1 (C[1], X[1], Y[1], S[1], C[2]);","sz":28.0}]},{"runs":[{"text":"fulladd","sz":28.0},{"text":" stage2 (C[2], X[2], Y[2], S[2], C[3]);","sz":28.0}]},{"runs":[{"text":"fulladd","sz":28.0},{"text":" stage3 (.","sz":28.0},{"text":"Cout","sz":28.0},{"text":"(carryout), .s(S[3]), .y(Y[3]), .x(X[3]), .","sz":28.0},{"text":"Cin","sz":28.0},{"text":"(C[3]));","sz":28.0}]},{"runs":[{"text":"endmodule","sz":28.0,"b":1}]}],"anchor":"t"}]},{"bg":null,"items":[]},{"bg":null,"items":[{"t":"text","box":[0.0652,0.0263,0.8172,0.2289],"paras":[{"runs":[{"text":"Exercise 1","sz":32.0}],"align":"just"},{"runs":[{"text":"Design a circuit using fu