{"id":"m5-l3","title":"Addressing modes","aspect":0.5625,"wpt":960,"slides":[{"bg":null,"items":[{"t":"text","box":[0.1236,0.3506,0.6371,0.2401],"paras":[{"runs":[{"text":"Addressing Modes","sz":40.0}],"title":1}],"anchor":"ctr"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"1","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.1236,0.5907,0.7398,0.16],"paras":[{"runs":[{"text":"Carl Hamacher, Zvonko ","sz":20.0,"b":1},{"text":"Vranesic","sz":20.0,"b":1},{"text":" and Safwat Zaky, Computer Organization and Embedded Systems, (6e), McGraw Hill Publication, 2017.","sz":20.0,"b":1}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0556,0.0889,0.7051,0.1926],"paras":[{"runs":[{"text":"Addressing modes","sz":40.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0386,0.1996,0.7721,0.5659],"paras":[{"runs":[{"text":"A program operates on data that reside in the computer\u2019s memory.","sz":24.0}],"bullet":1},{"runs":[{"text":"These data can be organized in a variety of ways that reflect the nature of the information and how it is used.","sz":24.0}],"bullet":1},{"runs":[{"text":"Programmers use data structures such as lists and arrays for organizing the data used in computations.","sz":24.0}],"bullet":1},{"runs":[{"text":"Programs are normally written in a high-level language, which enables the programmer to conveniently describe the operations to be performed on various data structures. ","sz":24.0}],"bullet":1},{"runs":[{"text":"When translating a high-level language program into assembly language, the compiler generates appropriate sequences of low-level instructions that implement the desired operations.","sz":24.0}],"bullet":1},{"runs":[{"text":"The different ways for specifying the locations of instruction operands are known as ","sz":24.0},{"text":"addressing modes.","sz":24.0,"b":1}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"2","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Addressing Modes","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0044,0.2029,0.3974,0.7781],"paras":[{"runs":[{"text":"Addressing modes: ","sz":24.0,"b":1}],"align":"just","bullet":1},{"runs":[{"text":"Different ways for specifying the locations of instruction operands.","sz":24.0}],"lvl":1,"align":"just","bullet":1},{"runs":[{"text":"RISC-style processors basic addressing modes Table 2.1","sz":24.0}],"align":"just","bullet":1},{"runs":[{"text":"The assembler syntax defines the way in which instructions and the addressing modes of their operands are specified","sz":24.0}],"align":"just","bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"3","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.4302,0.2899,0.5488,0.6381],"src":"/dsco/slides/m5-l3/1.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Implementation of Variables and Constants","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0178,0.156,0.5938,0.7781],"paras":[{"runs":[{"text":"Register mode","sz":24.0}],"bullet":1},{"runs":[{"text":"The operand is the contents of a processor register; the name of the register is given in the instruction.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Example: Add R4, R2, R3","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Absolute mode","sz":24.0}],"bullet":1},{"runs":[{"text":"The operand is in a memory location; the address of this location is given explicitly in the instruction.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Load R2, NUM1","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Immediate mode","sz":24.0}],"bullet":1},{"runs":[{"text":"The operand is given explicitly in the instruction.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Add R4, R6, 200","sz":24.0},{"text":"immediate","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"Add R4, R6, #200","sz":24.0}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"4","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.6124,0.4512,0.3491,0.2154],"paras":[{"runs":[{"text":"Since in a RISC-style processor an instruction must fit in a single word, the number of bits that can be used to give an absolute address is limited, typically to 16 bits if the word length is 32 bits.","sz":18.0,"sub":1}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Indirection and Pointers","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0044,0.2029,0.796,0.7781],"paras":[{"runs":[{"text":"Indirect mode:","sz":24.0}],"bullet":1},{"runs":[{"text":"The effective address of the operand is the contents of a register that is specified in the instruction","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Load R2, (R5)","sz":24.0}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"5","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.0565,0.4839,0.5959,0.4382],"src":"/dsco/slides/m5-l3/2.webp"},{"t":"text","box":[0.6019,0.3721,0.3415,0.2558],"paras":[{"runs":[{"text":"The register acts as a ","sz":18.0,"sub":1},{"text":"pointer ","sz":18.0,"i":1,"sub":1},{"text":"to the list, and we say that an item","sz":18.0,"sub":1},{"text":" in the list is accessed ","sz":18.0},{"text":"indirectly ","i":1,"sz":18.0},{"text":"by using the address in the register. The desired capability is provided by the indirect addressing mode.","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.4493,0.7397,0.5107,0.175],"paras":[{"runs":[{"text":"Indirection and the use of pointers are important and powerful concepts in programming.","sz":18.0,"sub":1}]},{"runs":[{"text":"They permit the same code to be used to operate on different data.","sz":18.0,"sub":1}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Indirection and Pointers","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"6","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.0,0.2029,0.327,0.7971],"src":"/dsco/slides/m5-l3/3.webp"},{"t":"img","box":[0.4279,0.1953,0.5676,0.5152],"src":"/dsco/slides/m5-l3/4.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Indirection and Pointers","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0044,0.2029,0.9758,0.7781],"paras":[{"runs":[{"text":"C-language statement","sz":24.0}],"bullet":1},{"runs":[{"text":"\tA = *B;       ","sz":24.0},{"text":"where B is a pointer variable and the \u2018*\u2019 symbol is the operator for indirect accesses","sz":20.0},{"text":".","sz":28.0}]},{"runs":[{"text":"      ","sz":28.0},{"text":"This statement causes the contents of the memory location pointed to by B to be loaded into memory    location ","sz":20.0},{"text":"A.","sz":28.0}]},{"runs":[],"gap":1},{"runs":[{"text":"Compiled to:","sz":24.0}],"bullet":1},{"runs":[{"text":"\tLoad R2, B  \t// loads the content in B i.e., the address of location where B is pointing at (ex: AAA0)","sz":24.0}]},{"runs":[{"text":"\tLoad R3, (R2)\t//go to location AAA0 and copy the data to R3","sz":24.0}]},{"runs":[{"text":"\tStore R3, A\t// store the content of R3 in A","sz":24.0}]}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"7","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.05,0.1349,0.2061,0.0673],"paras":[{"runs":[{"text":"Another Example","sz":24.0,"b":1}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Indexing and Arrays","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0044,0.2029,0.9233,0.7781],"paras":[{"runs":[{"text":"Index mode:","sz":24.0}],"bullet":1},{"runs":[{"text":" the effective address of the operand is generated by adding a constant value to the contents of a register.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"It is useful in dealing with lists and arrays.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Index register:  The register used in this mode is known as the index register","sz":24.0}],"bullet":1},{"runs":[{"text":"X(Ri): EA = X + [Ri]","sz":22.0}],"lvl":1,"bullet":1},{"runs":[{"text":"The constant X may be given either as an explicit number or as a symbolic name representing a numerical value.","sz":24.0}],"bullet":1},{"runs":[{"text":"If X is shorter than a word, sign-extension is needed.","sz":24.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"8","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Index Mode: Types","sz":44.0}],"title":1}],"anchor":"t"},{"t":"img","box":[0.1288,0.2976,0.695,0.5984],"src":"/dsco/slides/m5-l3/5.webp"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"9","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0044,0.2029,0.48,0.7781],"paras":[{"runs":[{"text":"Offset is given as a constant","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Index Mode: Types","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"10","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.1887,0.2869,0.6807,0.5749],"src":"/dsco/slides/m5-l3/6.webp"},{"t":"text","box":[0.0044,0.2029,0.48,0.7781],"paras":[{"runs":[{"text":"Offset is in the index register","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Indexed Addressing: Example","sz":44.0}],"title":1}],"anchor":"t"},{"t":"img","box":[0.3134,0.2029,0.3927,0.7316],"src":"/dsco/slides/m5-l3/7.webp"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"11","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0044,0.2029,0.48,0.7781],"paras":[{"runs":[{"text":"2D array representation","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0179,0.3839,0.2509,0.4174],"paras":[{"runs":[{"text":"list in Figure 2.10 represents a two-dimensional array having ","sz":20.0,"sub":1},{"text":"n ","sz":20.0,"i":1,"sub":1},{"text":"rows and four columns. ","sz":20.0,"sub":1}],"align":"just","bullet":1},{"runs":[{"text":"Each row contains the entries for one student, and the columns give the IDs and test scores.","sz":20.0,"sub":1}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Indexed Addressing: Example","sz":44.0}],"title":1}],"anchor":"t"},{"t":"img","box":[0.5944,0.1951,0.374,0.6967],"src":"/dsco/slides/m5-l3/7.webp"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"12","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.0198,0.1951,0.5546,0.7728],"src":"/dsco/slides/m5-l3/8.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Indexed Addressing: Variations","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0152,0.2047,0.825,0.5907],"paras":[{"runs":[{"text":"Base with Index: (","sz":24.0,"sub":1},{"text":"R","sz":24.0,"sub":1},{"text":"i","sz":24.0,"i":1,"sub":1},{"text":",R","sz":24.0,"sub":1},{"text":"j","sz":24.0,"i":1,"sub":1},{"text":")","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"EA = [Ri] + [","sz":24.0},{"text":"Rj","sz":24.0},{"text":"]","sz":24.0}],"lvl":1,"bullet":1},{"runs":[],"gap":1},{"runs":[{"text":"Base with Index plus constant: ","sz":24.0,"sub":1},{"text":"X(R","sz":24.0},{"text":"i","sz":24.0,"sub":1},{"text":", ","sz":24.0},{"text":"R","sz":24.0},{"text":"j","sz":24.0,"sub":1},{"text":")","sz":24.0}],"bullet":1},{"runs":[{"text":"EA = X + [R","sz":24.0},{"text":"i","sz":24.0,"sub":1},{"text":"] + [","sz":24.0},{"text":"R","sz":24.0},{"text":"j","sz":24.0,"sub":1},{"text":"]","sz":24.0}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"13","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"RISC Style","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0152,0.2047,0.902,0.7632],"paras":[{"runs":[{"text":"RISC style is characterized by:","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"Simple addressing modes","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"All instructions fitting in a single word","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"Fewer instructions in the instruction set, because of simple addressing modes","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"Arithmetic and logic operations that can be performed only on operands in processor registers","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"Load/store architecture that does not allow direct transfers from one memory location to another; such transfers must take place via a processor register","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"Simple instructions that are conducive to fast execution by the processing unit using techniques such as pipelining","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"Programs that tend to be larger in size, because more, but simpler instructions are needed to perform complex tasks","sz":24.0,"sub":1}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"14","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"CISC Style","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0152,0.2047,0.825,0.5907],"paras":[{"runs":[{"text":"CISC style is characterized by:","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"More complex addressing modes","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"More complex instructions, where an instruction may span multiple words","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"Many instructions that implement complex tasks","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"Arithmetic and logic operations that can be performed on memory operands as well as operands in processor registers","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"Transfers from one memory location to another by using a single Move instruction","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"Programs that tend to be smaller in size, because fewer, but more complex instructions are needed to perform complex tasks","sz":24.0,"sub":1}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"15","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"CISC Instruction Set","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0206,0.2077,0.825,0.7265],"paras":[{"runs":[{"text":"CISC instruction sets are not constrained to the load/store architecture, in which arithmetic and logic operations can be performed only on operands that are in processor registers. ","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"Instructions do not necessarily have to fit into a single word. ","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"Some instructions may occupy a single word, but others may span multiple words","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"Most arithmetic and logic instructions use the two-address format","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\t\t","sz":24.0},{"text":"Operation destination, source","sz":24.0,"sub":1}]},{"runs":[{"text":"An Add instruction of type ","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\t\t","sz":24.0},{"text":"Add B, A ","sz":24.0,"sub":1}]},{"runs":[{"text":"is written as","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\t\tB \u2190 [A] + [B]","sz":24.0,"sub":1}]}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"16","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"CISC Instruction Set: Example","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0152,0.2047,0.9241,0.7265],"paras":[{"runs":[{"text":"Consider the task of adding two numbers where all three operands may be in memory locations","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\t\tC = A + B","sz":24.0,"sub":1}]},{"runs":[{"text":"This cannot be done with a single two-address instruction. ","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"Another two-address instruction is required that copies the contents of one memory location into another. ","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\t\tMove C, B","sz":24.0,"sub":1}]},{"runs":[{"text":"which performs the operation C\u2190[B] (contents of location B is unchanged). ","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"The operation C\u2190[A] + [B] can now be performed by the two-instruction sequence","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\t\tMove C, B","sz":24.0,"sub":1}]},{"runs":[{"text":"\t\tAdd C, A","sz":24.0,"sub":1}]}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"17","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"CISC Instruction Set","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0152,0.2047,0.9241,0.7265],"paras":[{"runs":[{"text":"In some CISC processors one operand may be in the memory but the other must be in a register. ","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"In this case, the instruction sequence for the required task would be","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\t\tMove Ri, A","sz":24.0,"sub":1}]},{"runs":[{"text":"\t\tAdd Ri, B","sz":24.0,"sub":1}]},{"runs":[{"text":"\t\tMove C, Ri","sz":24.0,"sub":1}]},{"runs":[{"text":"The general form of the Move instruction is","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\t\tMove destination, source","sz":24.0,"sub":1}]},{"runs":[{"text":"where both the source and destination may be either a memory location or a processor register","sz":24.0,"sub":1}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"18","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Additional Addressing Modes","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0187,0.1368,0.9241,0.7265],"paras":[{"runs":[{"text":"Autoincrement mode:\t\t(Ri)+","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"The effective address of the operand is the contents of a register specified in the instruction. ","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[{"text":"After accessing the operand, the contents of this register are automatically incremented to point to the next operand in memory","sz":24.0,"sub":1}],"lvl":1,"bullet":1},{"runs":[],"gap":1},{"runs":[{"text":"Computers that have the Autoincrement mode automatically increment the contents of the register by a value that corresponds to the size of the accessed operand. ","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"Increment is 1 for byte-sized operands, 2 for 16-bit operands, and 4 for 32-bit operands.","sz":24.0,"sub":1}],"bullet":1},{"runs":[],"gap":1},{"runs":[{"text":"Autodecrement mode: \t\u2212(Ri)","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"The contents of a register specified in the instruction are first automatically decremented and are then used as the effective address of the operand","sz":24.0,"sub":1}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"19","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Additional Addressing Modes","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0187,0.1956,0.9241,0.7265],"paras":[{"runs":[{"text":"To","sz":24.0},{"text":" push a new item on the stack, ","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\t","sz":24.0},{"text":"Subtract SP, #4","sz":24.0,"sub":1}]},{"runs":[{"text":"\tMove (SP), NEWITEM","sz":24.0,"sub":1}]},{"runs":[{"text":"just one instruction can be used","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\tMove \u2212(SP), NEWITEM","sz":24.0,"sub":1}]},{"runs":[],"gap":1},{"runs":[{"text":"Similarly, to pop an item from the stack","sz":24.0,"sub":1},{"text":",","sz":24.0}],"bullet":1},{"runs":[{"text":"\tMove ITEM, (SP)","sz":24.0,"sub":1}]},{"runs":[{"text":"\tAdd SP, #4","sz":24.0,"sub":1}]},{"runs":[{"text":"We can use just","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"\tMove ITEM, (SP)+","sz":24.0,"sub":1}]}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"20","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Additional Addressing Modes","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0152,0.2047,0.9241,0.7265],"paras":[{"runs":[{"text":"Relative mode:","sz":24.0}],"bullet":1},{"runs":[{"text":"the effective address is determined by the Index mode using the program counter in place of the general-purpose register.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"X(PC) \u2013 note that X is a signed number","sz":24.0}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"21","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Condition Codes","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0152,0.2047,0.9241,0.7265],"paras":[{"runs":[{"text":"Operations performed by the processor typically generate results such as numbers that are positive, negative, or zero","sz":24.0}],"bullet":1},{"runs":[{"text":"Maintain the information about these results for use by subsequent conditional branch instructions","sz":24.0}],"bullet":1},{"runs":[{"text":"Accomplished by recording the required information in individual bits, often called condition code flags","sz":24.0}],"bullet":1},{"runs":[{"text":"These flags are usually grouped together in a special processor register called the condition code register or status register. ","sz":24.0}],"bullet":1},{"runs":[{"text":"Individual condition code flags are set to 1 or cleared to 0, depending on the outcome of the operation performed","sz":24.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"22","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Condition Codes","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0152,0.2047,0.9241,0.7265],"paras":[{"runs":[{"text":"Commonly used flags:","sz":24.0}],"bullet":1},{"runs":[],"gap":1},{"runs":[],"gap":1},{"runs":[],"gap":1},{"runs":[],"gap":1},{"runs":[],"gap":1},{"runs":[],"gap":1},{"runs":[{"text":"e.g.  Branch>0 LOOP","sz":24.0}],"bullet":1},{"runs":[{"text":"This instruction causes a branch if both N and Z are 0, that is, if the result produced by previous arithmetic instruction is neither negative nor equal to zero","sz":24.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"23","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.1137,0.3295,0.8098,0.2768],"src":"/dsco/slides/m5-l3/9.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Condition Codes","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0,0.1966,0.9241,0.7265],"paras":[{"runs":[{"text":"CISC style programming to add a list of numbers","sz":24.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"24","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.1023,0.352,0.7206,0.5556],"src":"/dsco/slides/m5-l3/10.webp"},{"t":"img","box":[0.5682,-0.0106,0.4318,0.392],"src":"/dsco/slides/m5-l3/4.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Example Program: ","sz":44.0},{"text":"\n","sz":40.0},{"text":"Vector Dot Product Program (RISC style)","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"25","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.1662,0.2903,0.6677,0.6776],"src":"/dsco/slides/m5-l3/11.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Example Program: ","sz":44.0},{"text":"\n","sz":40.0},{"text":"Vector Dot Product Program (CISC style)","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"26","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.1512,0.3035,0.6977,0.6277],"src":"/dsco/slides/m5-l3/12.webp"}]}]}