null},{"text":"","span":1,"rows":1,"fill":null}]]}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Booth\u2019s algorithm: 23X29","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.015,0.1916,0.932,0.7931],"paras":[{"runs":[{"text":"M=23=010111\t\tQ=29=011101\t\t-M=101001","sz":28.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"6","sz":18.0}]}],"anchor":"t"},{"t":"table","box":[0.0328,0.243,0.8617,0.7345],"rows":[[{"text":"A","span":1,"rows":1,"fill":null},{"text":"Q","span":1,"rows":1,"fill":null},{"text":"Q -1","span":1,"rows":1,"fill":null},{"text":"M","span":1,"rows":1,"fill":null},{"text":"","span":1,"rows":1,"fill":null}],[{"text":"000000","span":1,"rows":1,"fill":null},{"text":"011101","span":1,"rows":1,"fill":null},{"text":"0","span":1,"rows":1,"fill":null},{"text":"010111","span":1,"rows":1,"fill":null},{"text":"Initial values","span":1,"rows":1,"fill":null}],[{"text":"101001 101001 110100","span":1,"rows":1,"fill":null},{"text":"011101 101110","span":1,"rows":1,"fill":null},{"text":"0 1","span":1,"rows":1,"fill":null},{"text":"010111","span":1,"rows":1,"fill":null},{"text":"A=A-M  Shift Right-1st cycle","span":1,"rows":1,"fill":null}],[{"text":"010111 001011 000101","span":1,"rows":1,"fill":null},{"text":"101110 110111","span":1,"rows":1,"fill":null},{"text":"1 0","span":1,"rows":1,"fill":null},{"text":"010111","span":1,"rows":1,"fill":null},{"text":"A=A+M Shift Right-   2nd cycle","span":1,"rows":1,"fill":null}],[{"text":"101001 101110 110111","span":1,"rows":1,"fill":null},{"text":"110111 011011","span":1,"rows":1,"fill":null},{"text":"0 1","span":1,"rows":1,"fill":null},{"text":"010111","span":1,"rows":1,"fill":null},{"text":"A=A-M  Shift Right-   3rd cycle","span":1,"rows":1,"fill":null}],[{"text":"111011","span":1,"rows":1,"fill":null},{"text":"101101","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null},{"text":"010111","span":1,"rows":1,"fill":null},{"text":"Shift Right-   4th cycle","span":1,"rows":1,"fill":null}],[{"text":"111101","span":1,"rows":1,"fill":null},{"text":"110110","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null},{"text":"010111","span":1,"rows":1,"fill":null},{"text":"Shift Right 5th cycle","span":1,"rows":1,"fill":null}],[{"text":"010111 010100 001010","span":1,"rows":1,"fill":null},{"text":"110110 011011","span":1,"rows":1,"fill":null},{"text":"1 0","span":1,"rows":1,"fill":null},{"text":"010111","span":1,"rows":1,"fill":null},{"text":"A=A+M Shift Right-   6th cycle","span":1,"rows":1,"fill":null}],[{"text":"","span":1,"rows":1,"fill":null},{"text":"001010011011\u2192667 Product=667","span":2,"rows":1,"fill":null},null,{"text":"","span":1,"rows":1,"fill":null},{"text":"","span":1,"rows":1,"fill":null}]]}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Multiplication: Booth\u2019s Algorithm","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"7","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.2154,0.2369,0.6018,0.7311],"src":"/dsco/slides/m6-l1/4.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Division","sz":44.0}],"title":1}],"anchor":"t"},{"t":"img","box":[0.2157,0.2369,0.5687,0.5352],"src":"/dsco/slides/m6-l1/5.webp"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"8","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Division","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"9","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.3398,0.1972,0.4171,0.7667],"src":"/dsco/slides/m6-l1/6.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Division","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"10","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.2398,0.2123,0.5737,0.7729],"src":"/dsco/slides/m6-l1/7.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Division: Algorithm","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0226,0.1793,0.8553,0.7931],"paras":[{"runs":[{"text":"Assumption: divisor V and the dividend D are positive and that |V|< |D|. ","sz":28.0}],"bullet":1},{"runs":[{"text":"If |V|= |D|, then the quotient =1 and the remainder=0.  ","sz":28.0}],"bullet":1},{"runs":[{"text":"If |V|> |D|, then Q=0 and R=D. The algorithm can be summarized as follows:","sz":28.0}],"bullet":1},{"runs":[{"text":"Load the twos complement of the divisor into the M register; that is, the M register contains the negative of the divisor. Load the dividend into the A, Q registers. The dividend must be expressed as a 2n-bit positive number. Thus, for example, the 4-bit 0111 becomes 00000111.","sz":18.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Shift A, Q left 1 bit position.","sz":18.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Perform A=A-M. This operation subtracts the divisor from the contents of A.","sz":18.0}],"lvl":1,"bullet":1},{"runs":[],"gap":1},{"runs":[{"text":"If the result is nonnegative (most significant bit of A=0), then set Q0=1","sz":18.0}],"lvl":2,"bullet":1},{"runs":[{"text":"If the result is negative (most significant bit of A=1), then set  Q0=0, and restore the previous value of A.","sz":18.0}],"lvl":2,"bullet":1},{"runs":[{"text":"Repeat steps 2 through 4 as many times as there are bit positions in Q.","sz":18.0}],"lvl":1,"bullet":1},{"runs":[{"text":"The remainder is in A and the quotient is in Q.","sz":18.0}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"11","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Division: Example","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0284,0.141,0.8553,0.7931],"paras":[{"runs":[{"text":"Divide 8 by 3;  \tM=-3=11101; \t\tQ=01000","sz":20.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"12","sz":18.0}]}],"anchor":"t"},{"t":"table","box":[0.0609,0.2294,0.6438,0.7624],"rows":[[{"text":"A","span":1,"rows":1,"fill":null},{"text":"Q","span":1,"rows":1,"fill":null},{"text":"","span":1,"rows":1,"fill":null}],[{"text":"00000","span":1,"rows":1,"fill":null},{"text":"01000","span":1,"rows":1,"fill":null},{"text":"Initial values","span":1,"rows":1,"fill":null}],[{"text":"00000 11101 11101 + 00011                  00000","span":1,"rows":1,"fill":null},{"text":"10000  10000 10000","span":1,"rows":1,"fill":null},{"text":"Shift Left Subtract Divisor(Add 2\u2019s complement of divisor) Set Q0=0 Restore   1st Cycle","span":1,"rows":1,"fill":null}],[{"text":"00001 11101 11110 + 00011                 00001","span":1,"rows":1,"fill":null},{"text":"00000  00000 00000","span":1,"rows":1,"fill":null},{"text":"Shift Left Subtract Divisor(Add 2\u2019s complement of divisor) Set Q0=0 Restore   2nd Cycle","span":1,"rows":1,"fill":null}],[{"text":"00010 11101 11111+  00011                 00010","span":1,"rows":1,"fill":null},{"text":"00000  00000 00000","span":1,"rows":1,"fill":null},{"text":"Shift Left Subtract Divisor(Add 2\u2019s complement of divisor) Set Q0=0 Restore   3rd  Cycle","span":1,"rows":1,"fill":null}],[{"text":"00100 11101 00001","span":1,"rows":1,"fill":null},{"text":"00000  00001","span":1,"rows":1,"fill":null},{"text":"Shift Left Subtract Set Q0=1   4th cycle","span":1,"rows":1,"fill":null}],[{"text":"00010 11101 11111 + 00011                00010","span":1,"rows":1,"fill":null},{"text":"00010  00010 00010","span":1,"rows":1,"fill":null},{"text":"Shift left Subtract Divisor(Add 2\u2019s complement of divisor) Set Q0=0 Restore   5th  Cycle","span":1,"rows":1,"fill":null}]]}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Division","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0177,0.1916,0.8553,0.7931],"paras":[{"runs":[{"text":"Consider the following examples of integer division with all possible combinations of signs of D and V:","sz":28.0}],"bullet":1},{"runs":[{"text":"\tD = 7\tV = 3 \t","sz":28.0},{"text":"\u2794\t","sz":28.0},{"text":"Q = 2\tR = 1","sz":28.0}]},{"runs":[{"text":"\tD = 7\tV = -3\t","sz":28.0},{"text":"\u2794","sz":28.0},{"text":" \tQ = -2 \tR = 1","sz":28.0}]},{"runs":[{"text":"\tD = -7 \tV = 3 \t","sz":28.0},{"text":"\u2794","sz":28.0},{"text":" \tQ = -2 \tR = -1","sz":28.0}]},{"runs":[{"text":"\tD = -7 \tV = -3 \t","sz":28.0},{"text":"\u2794","sz":28.0},{"text":" \tQ = 2 \tR = -1","sz":28.0}]},{"runs":[{"text":"(-7)/(3) and (7)/(-3) produce different remainders. ","sz":28.0}],"bullet":1},{"runs":[{"text":"The magnitudes of Q and R are unaffected by the input signs ","sz":28.0}],"bullet":1},{"runs":[{"text":"The signs of Q and R are easily derivable from the signs of D and V.","sz":28.0}],"bullet":1},{"runs":[{"text":"sign(R) = sign(D) ","sz":18.0}],"lvl":1,"bullet":1},{"runs":[{"text":"sign(Q) = sign(D) * sign(V). ","sz":18.0}],"lvl":1,"bullet":1},{"runs":[{"text":"One way to do twos complement division is to convert the operands into unsigned values and, at the end, to account for the signs by complementation where needed.","sz":28.0}],"bullet":1},{"runs":[{"text":"This is the method of choice for the restoring division algorithm.","sz":28.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"13","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0007,0.825,0.2347],"paras":[{"runs":[{"text":"Exercise","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0,0.1979,0.948,0.777],"paras":[{"runs":[{"text":"Given x and y in twos complement notation i.e., x=0101 and y=1010,compute the product p=x*y with Booth\u2019s algorithm","sz":24.0}],"bullet":1},{"runs":[{"text":"Use the Booth algorithm to multiply 23 (multiplicand) by 29 (multiplier), where each number is represented using 6 bits","sz":24.0}],"bullet":1},{"runs":[{"text":"Divide  145 by 13 in binary twos complement notation, using 12-bit words. Use the restoring division algorithm","sz":24.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"14","sz":18.0}]}],"anchor":"t"}]}]}