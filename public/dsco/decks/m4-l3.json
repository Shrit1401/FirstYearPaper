{"id":"m4-l3","title":"Verilog for sequential circuits","aspect":0.5625,"wpt":960,"slides":[{"bg":null,"items":[{"t":"text","box":[0.2609,0.0583,0.5268,0.0763],"paras":[{"runs":[{"text":"Blocking and Non-Blocking Assignments","sz":28.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.4389,0.1958,0.1632,0.0763],"paras":[{"runs":[{"text":"f = x1 & x2;","sz":28.0,"sub":1}]}],"anchor":"t"},{"t":"text","box":[0.0637,0.3608,0.8726,0.5161],"paras":[{"runs":[{"text":"This notation is called a ","sz":28.0,"sub":1},{"text":"blocking ","sz":28.0,"i":1,"sub":1},{"text":"assignment. ","sz":28.0,"sub":1}]},{"runs":[],"gap":1},{"runs":[{"text":"A Verilog compiler evaluates the statements","sz":28.0,"sub":1},{"text":" ","sz":28.0},{"text":"in an ","sz":28.0,"sub":1},{"text":"always ","sz":28.0,"b":1,"sub":1},{"text":"block in the order in which they are written. ","sz":28.0,"sub":1}]},{"runs":[],"gap":1},{"runs":[{"text":"If a variable is given a value by","sz":28.0,"sub":1},{"text":" ","sz":28.0},{"text":"a blocking assignment statement, then this ","sz":28.0,"sub":1},{"text":"new value is used in evaluating all subsequent","sz":28.0,"b":1,"sub":1},{"text":" ","sz":28.0,"b":1},{"text":"statements in the block.","sz":28.0,"b":1,"sub":1}]}],"anchor":"t"},{"t":"text","box":[0.25,0.8152,0.5,0.1212],"paras":[{"runs":[{"text":"B = A","sz":24.0,"sub":1}]},{"runs":[{"text":"C = B + 1","sz":24.0,"sub":1}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0426,0.0,0.8702,0.8303],"paras":[{"runs":[{"text":"Verilog also provides a ","sz":28.0,"b":1,"sub":1},{"text":"non-blocking ","sz":28.0,"b":1,"i":1,"sub":1},{"text":"assignment, denoted with ","sz":28.0,"b":1,"sub":1},{"text":"<","sz":28.0,"b":1,"i":1,"sub":1},{"text":"=. ","sz":28.0,"b":1,"sub":1}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"All non-blocking","sz":28.0,"sub":1},{"text":" ","sz":28.0},{"text":"assignment statements in an ","sz":28.0,"sub":1},{"text":"always ","sz":28.0,"b":1,"sub":1},{"text":"block are evaluated using the values that the variables","sz":28.0,"sub":1},{"text":" ","sz":28.0},{"text":"have when the ","sz":28.0,"sub":1},{"text":"always ","sz":28.0,"b":1,"sub":1},{"text":"block is entered. ","sz":28.0,"sub":1}],"align":"just","bullet":1},{"runs":[{"text":"Nonblocking assignments are executed concurrently by evaluating the set of expressions on the right-hand side of the list of statements;","sz":28.0}],"bullet":1},{"runs":[{"text":"They do not make assignments to their left-hand sides until all of the expressions are evaluated.","sz":28.0}],"bullet":1},{"runs":[{"text":"Thus, a given variable has the same value for all","sz":28.0,"sub":1},{"text":" ","sz":28.0},{"text":"statements in the block. ","sz":28.0,"sub":1}],"align":"just","bullet":1},{"runs":[{"text":"The meaning of non-blocking is that the result of each assignment","sz":28.0,"sub":1},{"text":" ","sz":28.0},{"text":"is not seen until the end of the ","sz":28.0,"sub":1},{"text":"always ","sz":28.0,"b":1,"sub":1},{"text":"block.","sz":28.0,"sub":1}],"align":"just","bullet":1}],"anchor":"t"},{"t":"text","box":[0.3117,0.8303,0.5,0.1212],"paras":[{"runs":[{"text":"B <= A","sz":24.0,"sub":1}]},{"runs":[{"text":"C <= B + 1","sz":24.0,"sub":1}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.1788,0.0456,0.6851,0.0853],"paras":[{"runs":[{"text":"Using Verilog Constructs for Storage Elements","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.2713,0.2091,0.5,0.4443],"paras":[{"runs":[{"text":"module ","sz":32.0,"b":1,"sub":1},{"text":"flipflop","sz":32.0,"sub":1},{"text":" (D, Clock, Q);","sz":32.0,"sub":1}]},{"runs":[{"text":"input ","sz":32.0,"b":1,"sub":1},{"text":"D, Clock;","sz":32.0,"sub":1}]},{"runs":[{"text":"output ","sz":32.0,"b":1,"sub":1},{"text":"reg","sz":32.0,"b":1,"sub":1},{"text":" ","sz":32.0,"b":1,"sub":1},{"text":"Q;","sz":32.0,"sub":1}]},{"runs":[{"text":"always ","sz":32.0,"b":1,"sub":1},{"text":"@(","sz":32.0,"sub":1},{"text":"posedge","sz":32.0,"b":1,"sub":1},{"text":" ","sz":32.0,"b":1,"sub":1},{"text":"Clock)","sz":32.0,"sub":1}]},{"runs":[{"text":"Q = D;","sz":32.0,"sub":1}]},{"runs":[{"text":"endmodule","sz":32.0,"b":1,"sub":1}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0708,0.0976,0.83,0.6433],"paras":[{"runs":[{"text":"A general rule is to ","sz":24.0,"sub":1},{"text":"use blocking assignments when sequential ordering is imperative and in cyclic behavior that is level sensitive ","sz":24.0,"b":1,"sub":1},{"text":"(i.e., in combinational logic). ","sz":24.0,"sub":1}],"bullet":1},{"runs":[{"text":"Use nonblocking assignments when modeling concurrent execution ","sz":24.0,"b":1,"sub":1},{"text":"(e.g., edge-sensitive behavior such as synchronous, concurrent register transfers) ","sz":24.0,"sub":1},{"text":"and when modeling latched behavior .","sz":24.0,"b":1,"sub":1}],"bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"img","box":[0.0036,0.0159,0.3636,0.3503],"src":"/dsco/slides/m4-l3/1.webp"},{"t":"text","box":[0.5116,0.0247,0.394,0.4622],"paras":[{"runs":[{"text":"module ","sz":20.0,"b":1,"sub":1},{"text":"example5_3 (D, Clock, Q1, Q2);","sz":20.0,"sub":1}]},{"runs":[{"text":"input ","sz":20.0,"b":1,"sub":1},{"text":"D, Clock;","sz":20.0,"sub":1}]},{"runs":[{"text":"output ","sz":20.0,"b":1,"sub":1},{"text":"reg","sz":20.0,"b":1,"sub":1},{"text":" ","sz":20.0,"b":1,"sub":1},{"text":"Q1, Q2;","sz":20.0,"sub":1}]},{"runs":[{"text":"always ","sz":20.0,"b":1,"sub":1},{"text":"@(","sz":20.0,"sub":1},{"text":"posedge","sz":20.0,"b":1,"sub":1},{"text":" ","sz":20.0,"b":1,"sub":1},{"text":"Clock)","sz":20.0,"sub":1}]},{"runs":[{"text":"begin","sz":20.0,"b":1,"sub":1}]},{"runs":[{"text":"Q1 = D;","sz":20.0,"sub":1}]},{"runs":[{"text":"Q2 = Q1;","sz":20.0,"sub":1}]},{"runs":[{"text":"end","sz":20.0,"b":1,"sub":1}]},{"runs":[{"text":"endmodule","sz":20.0,"b":1,"sub":1}]},{"runs":[{"text":".","sz":20.0,"sub":1}],"align":"ctr"}],"anchor":"t"},{"t":"shape","box":[0.3896,0.191,0.0996,0.0648],"geom":"rightArrow","fill":