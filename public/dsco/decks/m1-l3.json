{"id":"m1-l3","title":"Karnaugh maps","aspect":0.5625,"wpt":960,"slides":[{"bg":null,"items":[{"t":"text","box":[0.3666,0.1074,0.2505,0.0853],"paras":[{"runs":[{"text":"Karnaugh","sz":32.0,"b":1},{"text":" map","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.0945,0.277,0.7938,0.5161],"paras":[{"runs":[{"text":"Karnaugh map provides a systematic way of producing a minimum-cost logic expression.","sz":32.0}],"align":"just","bullet":1},{"runs":[{"text":"It is an alternative to the truth-table form for representing a function. The map consists of ","sz":32.0},{"text":"cells ","sz":32.0,"i":1},{"text":"that correspond to the rows of the truth table.","sz":32.0}],"align":"just","bullet":1},{"runs":[{"text":"It allows easy recognition of ","sz":32.0},{"text":"minterms","sz":32.0},{"text":" that can be combined.","sz":32.0}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.1352,0.1761,0.6943,0.5879],"paras":[{"runs":[{"text":"Minterms","sz":32.0},{"text":" in any two cells that are adjacent, either in the same row or the same column, can be combined.","sz":32.0}],"align":"just","bullet":1},{"runs":[{"text":"The adjacent cells must differ in the value of only one variable.","sz":32.0}],"align":"just","bullet":1},{"runs":[{"text":"In case of Three variable K map, the columns are identified by the sequence of (x1, x2) values of 00, 01, 11, and 10.  ","sz":32.0}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.092,0.1095,0.7977,0.5161],"paras":[{"runs":[{"text":"This makes the second and third columns different only in variable x1. Also, the first and the fourth columns differ only in variable x1, which means that these columns can be considered as being adjacent.  (A sequence of codes, or valuations, where consecutive codes differ in one variable only is known as the Gray code.)","sz":32.0}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0722,0.1175,0.2965,0.0853],"paras":[{"runs":[{"text":"Two-Variable Map","sz":32.0,"b":1}],"align":"just"}],"anchor":"t"},{"t":"img","box":[0.1354,0.2189,0.2604,0.5875],"src":"/dsco/slides/m1-l3/1.webp"},{"t":"img","box":[0.4784,0.277,0.3209,0.4789],"src":"/dsco/slides/m1-l3/2.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0722,0.1175,0.2965,0.0853],"paras":[{"runs":[{"text":"Two-Variable Map","sz":32.0,"b":1}],"align":"just"}],"anchor":"t"},{"t":"img","box":[0.1223,0.2418,0.2371,0.4111],"src":"/dsco/slides/m1-l3/3.webp","crop":[0.0,0.0,0.33743,0.0]},{"t":"table","box":[0.4937,0.3537,0.3274,0.2871],"rows":[[{"text":"x1 x2","span":1,"rows":1,"fill":null},{"text":"0","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null}],[{"text":"0","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null},{"text":"0","span":1,"rows":1,"fill":null}],[{"text":"1","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null}]]},{"t":"line","box":[0.4948,0.3562,0.1075,0.0915],"flipH":false,"flipV":false,"color":"#000000","head":false}]},{"bg":null,"items":[{"t":"text","box":[0.1352,0.1761,0.6943,0.6059],"paras":[{"runs":[{"text":"The ","sz":24.0},{"text":"Karnaugh","sz":24.0},{"text":" map provides a simple mechanism for generating the product terms that should be used to implement a given function. ","sz":24.0}],"align":"just","bullet":1},{"runs":[{"text":"A product term must include only those variables that have the same value for all cells in the group represented by this term. ","sz":24.0}],"align":"just","bullet":1},{"runs":[{"text":"If the variable is equal to 1 in the group, it appears ","sz":24.0},{"text":"uncomplemented","sz":24.0},{"text":" in the product term; if it is equal to 0, it appears complemented. ","sz":24.0}],"align":"just","bullet":1},{"runs":[{"text":"Each variable that is sometimes 1 and sometimes 0 in the group does not appear in the product term.","sz":24.0}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0656,0.1175,0.3098,0.0853],"paras":[{"runs":[{"text":"Three-Variable Map","sz":32.0,"b":1}],"align":"just"}],"anchor":"t"},{"t":"img","box":[0.134,0.2027,0.2044,0.7122],"src":"/dsco/slides/m1-l3/4.webp","crop":[0.0,0.0,0.67474,0.0]},{"t":"img","box":[0.4701,0.2844,0.3429,0.4798],"src":"/dsco/slides/m1-l3/4.webp","crop":[0.45432,0.0,0.0,0.32628]}]},{"bg":null,"items":[{"t":"img","box":[0.0773,0.0746,0.4341,0.8165],"src":"/dsco/slides/m1-l3/5.webp"},{"t":"table","box":[0.5787,0.3085,0.2904,0.3057],"rows":[[{"text":"x1x2 x3","span":1,"rows":1,"fill":null},{"text":"00","span":1,"rows":1,"fill":null},{"text":"01","span":1,"rows":1,"fill":null},{"text":"11","span":1,"rows":1,"fill":null},{"text":"10","span":1,"rows":1,"fill":null}],[{"text":"0","span":1,"rows":1,"fill":null},{"text":"0","span":1,"rows":1,"fill":null},{"text":"0","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null}],[{"text":"1","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null},{"text":"0","span":1,"rows":1,"fill":null},{"text":"0","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null}]]},{"t":"line","box":[0.553,0.3483,0.0828,0.0935],"flipH":true,"flipV":true,"color":"#000000","head":false}]},{"bg":null,"items":[{"t":"img","box":[0.0773,0.0746,0.4341,0.8165],"src":"/dsco/slides/m1-l3/5.webp"},{"t":"img","box":[0.5299,0.3207,0.4379,0.3244],"src":"/dsco/slides/m1-l3/6.webp"}]},{"bg":null,"items":[{"t":"img","box":[0.1182,0.1208,0.3084,0.7593],"src":"/dsco/slides/m1-l3/7.webp"},{"t":"table","box":[0.5787,0.3085,0.2904,0.3057],"rows":[[{"text":"x1x2 x3","span":1,"rows":1,"fill":null},{"text":"00","span":1,"rows":1,"fill":null},{"text":"01","span":1,"rows":1,"fill":null},{"text":"11","span":1,"rows":1,"fill":null},{"text":"10","span":1,"rows":1,"fill":null}],[{"text":"0","span":1,"rows":1,"fill":null},{"text":"1","span":1,"rows":1,"fill":null},{"text":"