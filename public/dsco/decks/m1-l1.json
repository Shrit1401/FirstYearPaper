ems":[{"t":"text","box":[0.0714,0.1484,0.8504,0.4443],"paras":[{"runs":[{"text":"The complement operation can be applied to a single variable or to more complex operations. ","sz":32.0}],"align":"just"},{"runs":[{"text":"For example, if","sz":32.0}],"align":"just"},{"runs":[{"text":"f ","sz":32.0,"i":1},{"text":"(","sz":32.0,"i":1},{"text":"x","sz":32.0,"i":1},{"text":"1","sz":32.0,"sub":1},{"text":", ","sz":32.0,"i":1},{"text":"x","sz":32.0,"i":1},{"text":"2","sz":32.0,"sub":1},{"text":") ","sz":32.0,"i":1},{"text":"= ","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"1 ","sz":32.0,"sub":1},{"text":"+ ","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"2","sz":32.0,"sub":1}],"align":"ctr"},{"runs":[{"text":"then the complement of ","sz":32.0},{"text":"f ","sz":32.0,"i":1},{"text":"is","sz":32.0}],"align":"just"},{"runs":[{"text":"f\u2019","sz":32.0,"i":1},{"text":"(","sz":32.0,"i":1},{"text":"x","sz":32.0,"i":1},{"text":"1","sz":32.0},{"text":", ","sz":32.0,"i":1},{"text":"x","sz":32.0,"i":1},{"text":"2","sz":32.0},{"text":") ","sz":32.0,"i":1},{"text":"= (","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"1 ","sz":32.0,"sub":1},{"text":"+ ","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"2)\u2019","sz":32.0,"sub":1}],"align":"ctr"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0509,0.0826,0.8968,0.088],"paras":[{"runs":[{"text":"Precedence of Operations","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0509,0.2627,0.8968,0.3696],"paras":[{"runs":[{"text":"In the absence of parantheses, operation in a logic expression must be performed in the order: NOT, AND and OR.","sz":18.0}]},{"runs":[{"text":"Given f=a.b+a\u2019.b\u2019","sz":18.0}]},{"runs":[{"text":"        first, a\u2019 and b\u2019 are calculated, then ab and a\u2019b\u2019 and finally ab+a\u2019b\u2019","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.1068,0.1182,0.1646,0.0853],"paras":[{"runs":[{"text":"Minterms","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.0087,0.2049,1.0177,0.3725],"paras":[{"runs":[{"text":"For a function of ","sz":32.0},{"text":"n ","sz":32.0,"i":1},{"text":"variables, a ","sz":32.0},{"text":"product","sz":32.0,"u":1},{"text":" term in which each of the ","sz":32.0},{"text":"n ","sz":32.0,"i":1},{"text":"variables appears once, either in ","sz":32.0},{"text":"uncomplemented","sz":32.0},{"text":" or complemented form is called a ","sz":32.0},{"text":"minterm","sz":32.0,"i":1},{"text":".   ","sz":32.0}],"align":"just"},{"runs":[{"text":"For a given row of the truth table, the ","sz":32.0},{"text":"minterm","sz":32.0},{"text":" is formed by including ","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"i ","sz":32.0,"i":1,"sub":1},{"text":"if ","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"i ","sz":32.0,"i":1,"sub":1},{"text":"= ","sz":32.0},{"text":"1 and by including ","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"i\u2019 ","sz":32.0,"i":1,"sub":1},{"text":"if ","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"i ","sz":32.0,"i":1,"sub":1},{"text":"= ","sz":32.0},{"text":"0.","sz":32.0}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"img","box":[0.2336,0.1613,0.5052,0.7205],"src":"/dsco/slides/m1-l1/8.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.1432,0.166,0.7682,0.3007],"paras":[{"runs":[{"text":"Maxterms","sz":32.0,"b":1}],"align":"just"},{"runs":[{"text":"A sum term that contains all the variables in complemented or ","sz":32.0,"c":"#000000"},{"text":"uncomplemented","sz":32.0,"c":"#000000"},{"text":" from is called a ","sz":32.0,"c":"#000000"},{"text":"maxterm","sz":32.0,"c":"#000000"},{"text":".","sz":32.0,"c":"#000000"}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"img","box":[0.1569,0.0906,0.5052,0.7205],"src":"/dsco/slides/m1-l1/8.webp"},{"t":"img","box":[0.6622,0.1155,0.2311,0.6707],"src":"/dsco/slides/m1-l1/9.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0663,0.0967,0.6604,0.0763],"paras":[{"runs":[{"text":"Sum-of-Products and Product-of-Sums Forms","sz":28.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.0782,0.3927,0.8279,0.3038],"paras":[{"runs":[{"text":"If a function ","sz":32.0},{"text":"f ","sz":32.0,"i":1},{"text":"is specified in the form of a truth table, then an expression that realizes ","sz":32.0},{"text":"f ","sz":32.0,"i":1},{"text":"can be obtained by considering either the rows in the table for which ","sz":32.0},{"text":"f ","sz":32.0,"i":1},{"text":"= ","sz":32.0},{"text":"1,  or by considering the rows for which ","sz":32.0},{"text":"f ","sz":32.0,"i":1},{"text":"= ","sz":32.0},{"text":"0.","sz":32.0}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0785,0.1075,0.3361,0.0763],"paras":[{"runs":[{"text":"Sum-of-Products Form","sz":28.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.0785,0.2542,0.8518,0.3725],"paras":[{"runs":[{"text":"Any function ","sz":32.0},{"text":"f ","sz":32.0,"i":1},{"text":"can be represented by a sum of ","sz":32.0},{"text":"minterms","sz":32.0},{"text":" that correspond to the rows in the truth table for which ","sz":32.0},{"text":"f ","sz":32.0,"i":1},{"text":"= ","sz":32.0},{"text":"1.","sz":32.0}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"Example:","sz":32.0}],"align":"just"}],"anchor":"t"},{"t":"img","box":[0.2621,0.5077,0.3048,0.4673],"src":"/dsco/slides/m1-l1/10.webp"},{"t":"img","box":[0.6603,0.7219,0.306,0.0695],"src":"/dsco/slides/m1-l1/11.webp"},{"t":"text","box":[0.6483,0.7245,0.0241,0.0763],"paras":[{"runs":[{"text":"f","sz":28.0}]}],"anchor":"t"},{"t":"img","box":[0.6724,0.8184,0.244,0.0802],"src":"/dsco/slides/m1-l1/12.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0774,0.2022,0.7766,0.3725],"paras":[{"runs":[{"text":"A logic expression consisting of product (AND) terms that are summed (","sz":32.0},{"text":"ORed","sz":32.0},{"text":") is said to be in the ","sz":32.0},{"text":"sum-of products ","sz":32.0,"i":1},{"text":"(","sz":32.0},{"text":"SOP","sz":32.0,"i":1},{"text":") form. If each product term is a ","sz":32.0},{"text":"minterm","sz":32.0},{"text":", then the expression is called a ","sz":32.0},{"text":"canonical sum-of-products ","sz":32.0,"i":1},{"text":"for the function ","sz":32.0},{"text":"f","sz":32.0,"i":1}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.1614,0.1701,0.6875,0.5161],"paras":[{"runs":[{"text":"The ","sz":32.0},{"text":"cost ","sz":32.0,"i":1},{"text":"of a logic circuit is the total number of gates plus the total number of inputs to all gates in the circuit.  ","sz":32.0}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"The cost of the previous network is 13, because there are five gates and eight inputs to the gates.","sz":32.0}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[]},{"bg":null,"items":[{"t":"img","box":[0.033,0.208,0.348,0.6546],"src":"/dsco/slides/m1-l1/13.webp"},{"t":"text","box":[0.033,0.0307,0.5286,0.1391],"paras":[{"runs":[{"text":"Product of Sums","sz":28.0}],"align":"just"},{"runs":[{"text":"Example:","sz":28.0}],"align":"just"}],"anchor":"t"},{"t":"img","box":[0.3153,0.5,0.6952,0.0704],"src":"/dsco/slides/m1-l1/14.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.1015,0.1337,0.8184,0.0853],"paras":[{"runs":[{"text":"An alternative way of specifying our sample function is","sz":32.0}]}],"anchor":"t"},{"t":"img","box":[0.2468,0.2586,0.4672,0.0906],"src":"/dsco/slides/m1-l1/15.webp"},{"t":"img","box":[0.2624,0.4878,0.4179,0.0822],"src":"/dsco/slides/m1-l1/16.webp"},{"t":"text","box":[0.1224,0.3492,0.2355,0.0853],"paras":[{"runs":[{"text":"or more simply","sz":32.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.1261,0.2348,0.7455,0.5161],"paras":[{"runs":[{"text":"A logic expression consisting of sum (OR) terms that are the factors of a logical product (AND) is said to be of the ","sz":32.0},{"text":"product-of-sums ","sz":32.0,"i":1},{"text":"(","sz":32.0},{"text":"POS","sz":32.0,"i":1},{"text":") form. ","sz":32.0}],"align":"just","bullet":1},{"runs":[{"text":"If each sum term is a ","sz":32.0},{"text":"maxterm","sz":32.0},{"text":", then the expression is called a ","sz":32.0},{"text":"canonical product-of-sums ","sz":32.0,"i":1},{"text":"for the given function.  ","sz":32.0}],"align":"just","bullet":1}],"anchor":"t"}]}]}