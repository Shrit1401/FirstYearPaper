{"id":"m4-l5","title":"Synchronous counters","aspect":0.5625,"wpt":960,"slides":[{"bg":null,"items":[{"t":"text","box":[0.05,0.0576,0.9,0.0539],"paras":[{"runs":[{"text":"COUNTERS","sz":21.6}],"align":"ctr","title":1}],"anchor":"t"},{"t":"text","box":[0.0688,0.2662,0.8625,0.6345],"paras":[{"runs":[{"text":" A counter is a device which stores (and sometimes displays) the number of times a particular event or process has occurred, often in relationship to a clock.","sz":20.0}],"bullet":1},{"runs":[{"text":" A counter circuit is usually constructed with a number of flip-flops connected in cascade. ","sz":20.0}],"bullet":1},{"runs":[{"text":" Counters are a very widely used component in digital circuits, and are manufactured as separate integrated circuits and also incorporated as parts of larger integrated circuits. ","sz":20.0}],"bullet":1},{"runs":[],"gap":1},{"runs":[{"text":"Counters are broadly divided into two categories","sz":20.0}]},{"runs":[{"text":"    Asynchronous counter","sz":18.5}],"lvl":1,"bullet":1},{"runs":[{"text":"    Synchronous counter","sz":18.5}],"lvl":1,"bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0615,0.0677,0.4024,0.0763],"paras":[{"runs":[{"text":"Design of synchronous counters","sz":28.0,"b":1}]}],"anchor":"t"},{"t":"img","box":[0.0709,0.277,0.2805,0.4434],"src":"/dsco/slides/m4-l5/1.webp"},{"t":"img","box":[0.3846,0.1835,0.5243,0.7525],"src":"/dsco/slides/m4-l5/2.webp"}]},{"bg":null,"items":[{"t":"img","box":[0.1974,0.0732,0.5985,0.1549],"src":"/dsco/slides/m4-l5/3.webp"},{"t":"img","box":[0.2415,0.2294,0.5103,0.0449],"src":"/dsco/slides/m4-l5/4.webp"},{"t":"img","box":[0.2111,0.3368,0.4292,0.616],"src":"/dsco/slides/m4-l5/2.webp"}]},{"bg":null,"items":[{"t":"img","box":[0.1399,0.2132,0.7564,0.5211],"src":"/dsco/slides/m4-l5/5.webp","crop":[0.0,0.0,0.0,0.19708]}]},{"bg":null,"items":[{"t":"img","box":[0.0317,0.0545,0.35,0.0674],"src":"/dsco/slides/m4-l5/6.webp"},{"t":"text","box":[0.0511,0.1219,0.6646,0.1391],"paras