/dsco/slides/m1-l2/7.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0339,0.0153,0.9527,0.3007],"paras":[{"runs":[{"text":"The AND ","sz":32.0},{"text":"and","sz":32.0},{"text":" OR operations are indicated by the \u201c&\u201d and \u201c","sz":32.0},{"text":"|","sz":32.0},{"text":"\u201d Verilog operators, respectively. The ","sz":32.0},{"text":"assign ","sz":32.0,"i":1},{"text":"keyword provides a ","sz":32.0},{"text":"continuous assignment ","sz":32.0,"i":1},{"text":"for the signal ","sz":32.0},{"text":"f","sz":32.0,"i":1},{"text":".","sz":32.0}],"align":"just"},{"runs":[{"text":"Behavioral code for example 2 is as follows:","sz":32.0}],"align":"just"}],"anchor":"t"},{"t":"text","box":[0.1392,0.4686,0.7466,0.5161],"paras":[{"runs":[{"text":"module ","sz":32.0,"b":1},{"text":"example2 (x1, x2, x3, x4, f, g, h);","sz":32.0}]},{"runs":[{"text":"input ","sz":32.0,"b":1},{"text":"x1, x2, x3, x4;","sz":32.0}]},{"runs":[{"text":"output ","sz":32.0,"b":1},{"text":"f, g, h;","sz":32.0}]},{"runs":[{"text":"assign ","sz":32.0,"b":1},{"text":"g = (x1 & x3) ","sz":32.0},{"text":"| ","sz":32.0},{"text":"(x2 & x4);","sz":32.0}]},{"runs":[{"text":"assign ","sz":32.0,"b":1},{"text":"h = (x1 ","sz":32.0},{"text":"| ","sz":32.0},{"text":"x3) & ( x2 ","sz":32.0},{"text":"| ","sz":32.0},{"text":"x4);","sz":32.0}]},{"runs":[{"text":"assign ","sz":32.0,"b":1},{"text":"f = g ","sz":32.0},{"text":"| ","sz":32.0},{"text":"h;","sz":32.0}]},{"runs":[{"text":"endmodule","sz":32.0,"b":1}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"table","box":[0.2698,0.0617,0.5026,0.8736],"rows":[[{"text":"Operator type","span":1,"rows":1,"fill":null},{"text":"Operator Symbols","span":1,"rows":1,"fill":null},{"text":"Operation Performed","span":1,"rows":1,"fill":null},{"text":"Number of operands","span":1,"rows":1,"fill":null}],[{"text":"Bitwise","span":1,"rows":1,"fill":null},{"text":"~ & | ^ ~^ or  ^~","span":1,"rows":1,"fill":null},{"text":"1\u2019s complement Bitwise AND Bitwise OR Bitwise XOR Bitwise