ns","sz":32.0,"b":1}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"In digital systems it often happens that certain input conditions can never occur. For example, suppose that ","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"1 and ","sz":32.0},{"text":"x","sz":32.0,"i":1},{"text":"2 control two interlocked switches such that both switches cannot be closed at the same time. Then the input valuations (x1, x2) = 11 is guaranteed not to occur. Then we say that (x1, x2) = 11 is a don\u2019t-care condition, meaning that a circuit","sz":32.0}],"align":"just"},{"runs":[{"text":"with x1 and x2 as inputs can be designed by ignoring this condition. A function that has don\u2019t-care condition(s) is said to be incompletely specified.","sz":32.0}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.082,0.0572,0.4837,0.0763],"paras":[{"runs":[{"text":"Incompletely Specified Functions","sz":28.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.082,0.1561,0.8326,0.3276],"paras":[{"runs":[{"text":"A function that has don\u2019t-care condition(s) is said to be incompletely specified.","sz":28.0}],"bullet":1},{"runs":[{"text":"The don\u2019t cares ","sz":28.0},{"text":"are denoted by the letter ","sz":28.0},{"text":"d ","sz":28.0,"i":1},{"text":"in the map.","sz":28.0}],"bullet":1},{"runs":[{"text":"A function with don\u2019t care condition is specified as follows:","sz":28.0}],"bullet":1}],"anchor":"t"},{"t":"img","box":[0.1913,0.434,0.5995,0.0995],"src":"/dsco/slides/m1-l4/17.webp"},{"t":"text","box":[0.1157,0.5335,0.7328,0.0673],"paras":[{"runs":[{"text":"where ","sz":24.0},{"text":"D ","sz":24.0,"i":1},{"text":"is the set of don\u2019t-cares.","sz":24.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"table","box":[0.3399,0.313,0.3754,0.4222],"rows":[[{"text":"","span":1,"rows":1,"fill":null},{"text":"00","span":1,"rows":1,"fill":null},{"text":"01","span":1,"rows":1,"fill":null},{"text":"11","span":1,"rows":1,"fill":null},{"text":"10","span":1,"rows":1,"