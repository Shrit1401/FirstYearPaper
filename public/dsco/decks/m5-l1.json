{"id":"m5-l1","title":"Instruction set architecture","aspect":0.5625,"wpt":960,"slides":[{"bg":null,"items":[{"t":"text","box":[0.1165,0.1808,0.6371,0.2401],"paras":[{"runs":[{"text":"Computer Organization","sz":40.0}],"title":1}],"anchor":"ctr"},{"t":"text","box":[0.125,0.5538,0.75,0.2414],"paras":[{"runs":[{"text":"Carl Hamacher, Zvonko ","sz":20.0,"b":1},{"text":"Vranesic","sz":20.0,"b":1},{"text":" and Safwat Zaky, Computer Organization and Embedded Systems, (6e), McGraw Hill Publication, 2017.","sz":20.0,"b":1}],"align":"just"}],"anchor":"t"}]},{"bg":"#FFFFFF","items":[{"t":"shape","box":[0.0,0.0,1.0,1.0],"geom":"rect","fill":"#90C226","line":null},{"t":"text","box":[0.1094,0.0889,0.7051,0.1926],"paras":[{"runs":[{"text":"Introduction","sz":40.0}],"title":1}],"anchor":"t"},{"t":"shape","box":[0.0,0.0,0.0691,0.8262],"geom":"triangle","fill":"#90C226","line":null},{"t":"text","box":[0.1094,0.8809,0.4627,0.0532],"paras":[{"runs":[{"text":"CSS 2104","sz":12.0}]}],"anchor":"t"},{"t":"text","box":[0.8547,0.8682,0.056,0.0532],"paras":[{"runs":[{"text":"2","sz":12.0}]}],"anchor":"t"},{"t":"text","box":[0.0691,0.2267,0.8941,0.5659],"paras":[{"runs":[{"text":"Computer Architecture: refers to those attributes of a system visible to a programmer or those attributes that have a direct impact on the logical execution of a program.","sz":24.0}],"bullet":1},{"runs":[{"text":"Example: instruction sets, the number of bits used to represent various datatypes, I/O mechanisms and techniques for addressing memory.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[],"gap":1},{"runs":[{"text":"Computer Organization: refers to the operational units and their interconnections that realize the architectural specifications.","sz":24.0}],"bullet":1},{"runs":[{"text":"Example: hardware details transparent to the programmer, such as control signals, interfaces between the computer and the peripherals; and the memory technology used.","sz":24.0}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"shape","box":[0.9632,0.5852,0.0368,0.4148],"geom":"triangle","fill":"#90C226","line":null}]},{"bg":null,"items":[{"t":"text","box":[0.0556,0.8809,0.5165,0.0532],"paras":[{"runs":[{"text":"CSS 2104","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"3","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.212,0.3039,0.5063,0.4778],"src":"/dsco/slides/m5-l1/1.webp"},{"t":"text","box":[0.0993,0.2048,0.748,0.0942],"paras":[{"runs":[{"text":"A computer consists of five functionally independent main parts: input, memory, arithmetic","sz":18.0,"sub":1}]},{"runs":[{"text":"and logic, output, and control units","sz":18.0,"sub":1}]}],"anchor":"t"},{"t":"text","box":[0.0636,0.0658,0.5004,0.0942],"paras":[{"runs":[{"text":"Functional Units","sz":36.0,"b":1,"sub":1,"c":"#98C679"}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0556,0.8809,0.5165,0.0532],"paras":[{"runs":[{"text":"CSS 2104","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"4","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0402,0.1903,0.7393,0.3904],"paras":[{"runs":[{"text":"T","sz":24.0,"sub":1},{"text":"he input unit accepts coded information from human operators using devices such as keyboards, or from other computers over digital communication lines. ","sz":18.0}],"align":"just","bullet":1},{"runs":[{"text":"The information received is stored in the computer\u2019s memory, either for later use or to be processed immediately by the arithmetic and logic unit.","sz":18.0}],"align":"just","bullet":1},{"runs":[{"text":"The processing steps are specified by a program that is also stored in the memory. Finally, the results are sent back to the outside world through the output unit. ","sz":18.0}],"align":"just","bullet":1},{"runs":[{"text":"All of these actions are coordinated by the control unit.","sz":18.0}],"align":"just","bullet":1},{"runs":[{"text":" An interconnection network provides the means for the functional units to exchange information and coordinate their actions","sz":18.0}],"align":"just","bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0556,0.0889,0.7051,0.1926],"paras":[{"runs":[{"text":"Instruction Set Architecture","sz":40.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0556,0.315,0.7051,0.5659],"paras":[{"runs":[{"text":"A complete instruction set, including operand addressing methods, is often referred to as the ","sz":24.0},{"text":"instruction set architecture ","sz":24.0,"i":1},{"text":"(ISA) of a processor.","sz":24.0}],"align":"just","bullet":1}],"anchor":"t"},{"t":"text","box":[0.0556,0.8809,0.5165,0.0532],"paras":[{"runs":[{"text":"CSS 2104","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"5","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0556,0.0889,0.7051,0.1926],"paras":[{"runs":[{"text":"Memory Locations and Addresses","b":1,"sz":40.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0556,0.315,0.7051,0.5659],"paras":[{"runs":[{"text":"The memory consists of many millions of storage ","sz":24.0},{"text":"cells","sz":24.0,"i":1},{"text":", each of which can store a ","sz":24.0},{"text":"bit ","sz":24.0,"i":1},{"text":"of information having the value 0 or 1.","sz":24.0}],"bullet":1},{"runs":[{"text":" Because a single bit represents a very small amount of information, bits are seldom handled individually.","sz":24.0}],"bullet":1},{"runs":[{"text":" The usual approach is to deal with them in groups of fixed size.","sz":24.0}],"bullet":1},{"runs":[{"text":"For this purpose, the memory is organized so that a group of n bits can be stored or retrieved in a single, basic operation.","sz":24.0}],"bullet":1},{"runs":[{"text":" Each group of n bits is referred to as a word of information, and n is called the word length","sz":24.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.0556,0.8809,0.5165,0.0532],"paras":[{"runs":[{"text":"CSS 2104","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"6","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0556,0.05,0.7051,0.3262],"paras":[{"runs":[{"text":"Modern computers have word lengths that typically range from 16 to 64 bits. ","sz":24.0}],"bullet":1},{"runs":[{"text":"If the word length of a computer is 32 bits, a single word can store a 32-bit signed number or four ASCII-encoded characters, each occupying 8 bits, as shown","sz":24.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.0556,0.8809,0.5165,0.0532],"paras":[{"runs":[{"text":"CSS 2104","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"7","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.1746,0.3762,0.5301,0.5783],"src":"/dsco/slides/m5-l1/2.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0275,0.0658,0.7051,0.1389],"paras":[{"runs":[{"text":"The memory of a computer can be schematically represented as a collection of words, as shown","sz":24.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.0556,0.8809,0.5165,0.0532],"paras":[{"runs":[{"text":"CSS 2104","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"8","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.2516,0.2048,0.3868,0.7837],"src":"/dsco/slides/m5-l1/3.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.825,0.2347],"paras":[{"runs":[{"text":"Byte Addressability","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"9","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0044,0.1286,0.5333,0.808],"paras":[{"runs":[{"text":"Two ways that byte addresses can be assigned across words","sz":20.0}],"bullet":1},{"runs":[{"text":"Big-Endian: lower byte addresses are used for the most significant bytes of the word","sz":20.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Little-Endian: opposite ordering. Lower byte addresses are used for the less significant bytes of the word","sz":20.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Example: 15326","sz":20.0},{"text":"\u2192 ","sz":20.0},{"text":"1, 53 and 26 ","sz":20.0}],"lvl":2,"bullet":1},{"runs":[{"text":"Big-Endian: \tLittle-Endian: ","sz":20.0}],"lvl":2,"bullet":1},{"runs":[{"text":"Address:  Value\tAddress:  Value","sz":20.0}],"lvl":2,"bullet":1},{"runs":[{"text":"1000      : 01 \t       1000      : 26","sz":20.0}],"lvl":2,"bullet":1},{"runs":[{"text":"1001      : 53 \t       1001      : 53","sz":20.0}],"lvl":2,"bullet":1},{"runs":[{"text":"1002      : 26 \t       1002      : 01","sz":20.0}],"lvl":2,"bullet":1},{"runs":[{"text":"The words \u201cmore significant\u201d and \u201cless significant\u201d are used in relation to the powers of 2 assigned to bits when the word represents a number. ","sz":20.0}],"bullet":1}],"anchor":"t"},{"t":"img","box":[0.5768,0.1898,0.4188,0.5056],"src":"/dsco/slides/m5-l1/4.webp"},{"t":"img","box":[0.5272,0.6953,0.4723,0.1387],"src":"/dsco/slides/m5-l1/5.webp","crop":[0.0,0.0,0.0,0.77239]}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.825,0.2347],"paras":[{"runs":[{"text":"Word Alignment","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"10","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0044,0.2029,0.9758,0.7781],"paras":[{"runs":[{"text":"Word locations have aligned addresses if they begin at a byte address i.e., a multiple of the number of bytes in a word.","sz":24.0}],"bullet":1},{"runs":[{"text":"16-bit word: word addresses: 0, 2, 4,\u2026.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"32-bit word: word addresses: 0, 4, 8,\u2026.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"64-bit word: word addresses: 0, 8,16,\u2026.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"If words begin at arbitrary byte address, words are said to have unaligned addresses. ","sz":24.0}],"bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.825,0.2347],"paras":[{"runs":[{"text":"Accessing Numbers and Characters","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"11","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0044,0.2029,0.7522,0.7781],"paras":[{"runs":[{"text":"A number usually occupies one word and can be accessed in the memory by specifying its word address. ","sz":24.0}],"bullet":1},{"runs":[{"text":"Individual characters can be accessed by their byte address.","sz":24.0}],"bullet":1}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.825,0.2347],"paras":[{"runs":[{"text":"Memory Operations","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"12","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0044,0.2029,0.9758,0.7781],"paras":[{"runs":[{"text":"Load (or Read or Fetch)","sz":24.0}],"bullet":1},{"runs":[{"text":"Copy the content. The memory content doesn\u2019t change.","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Address \u2013 Load","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Registers can be used","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Store (or Write)","sz":24.0}],"bullet":1},{"runs":[{"text":"Overwrite the content in memory","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Address and Data \u2013 Store","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Registers can be used","sz":24.0}],"lvl":1,"bullet":1}],"anchor":"t"}]}]}