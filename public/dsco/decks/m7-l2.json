ata selector.","sz":18.5,"c":"#000000"}]},{"runs":[{"text":"3-bit ","sz":18.5,"c":"#000000"},{"text":"cond","sz":18.5,"c":"#000000"},{"text":" ","sz":18.5,"c":"#000000"},{"text":"sel","sz":18.5,"c":"#000000"},{"text":" field is used to encode 5 diff ","sz":18.5,"c":"#000000"},{"text":"cond","sz":18.5,"c":"#000000"},{"text":":","sz":18.5,"c":"#000000"}]},{"runs":[{"text":"\t\tCond Select Field       Action Taken","b":1,"c":"#000000","sz":16.7}]},{"runs":[{"text":"\t\t\t0   0   0\t\tNo branching","c":"#000000","sz":16.7}]},{"runs":[{"text":"\t\t\t0   0   1\t\tBranch if Q[1]Q[0]=01","c":"#000000","sz":16.7}]},{"runs":[{"text":"\t\t\t0   1   0\t\tBranch if Q[1]Q[0]=10","c":"#000000","sz":16.7}]},{"runs":[{"text":"\t\t\t0   1   1\t\tBranch if Z=0","c":"#000000","sz":16.7}]},{"runs":[{"text":"\t\t\t1   0   0\t\tUnconditional branch","sz":18.5,"c":"#000000"}]},{"runs":[{"text":"Size of CW\t","sz":18.5,"c":"#000000"},{"text":"= ","c":"#000000","sz":16.7},{"text":"Size of Cond ","sz":18.5,"c":"#000000"},{"text":"sel","sz":18.5,"c":"#000000"},{"text":" field   +  Size of branch(size of address bits) +  No of functions field","sz":18.5,"c":"#000000"}]},{"runs":[{"text":"\t\t= 3 + 4 + 10","sz":18.5,"c":"#000000"}]},{"runs":[{"text":" \t\t= 17 bits","sz":18.5,"c":"#000000"}]},{"runs":[{"text":"Size of CMDB is 17 bits and CM is 13 x 17 =221bits","sz":18.5,"c":"#000000"}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[-0.0,0.0007,0.9689,0.2347],"paras":[{"runs":[{"text":"Design of Microprogrammed CU for 4X4 Booth\u2019s Multiplier","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"10","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.0952,0.2203,0.7226,0.6741],"src":"/dsco/slides/m7-l2/5.webp"}]},{"bg":null,"items":[{"t":"text","box":[-0.0,0.0007,0.9689,0.2347],"paras":[{"runs":[{"text":"Design of Microprogrammed CU for 4X4 Booth\u2019s Multiplier","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,