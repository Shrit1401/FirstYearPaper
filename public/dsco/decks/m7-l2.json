x":[0.0311,0.2008,0.9377,0.7315],"paras":[{"runs":[{"text":"Consider the following register transfer description algorithm","sz":20.0}]},{"runs":[{"text":"Declare Registers: A[8], B[8], C[8];","sz":20.0}]},{"runs":[{"text":"START: \tA","sz":20.0},{"text":" \u2190","sz":20.0,"c":"#000000"},{"text":" 0;","sz":20.0}]},{"runs":[{"text":"\t\tB","sz":20.0},{"text":" \u2190 ","sz":20.0,"c":"#000000"},{"text":"00001010;","sz":20.0}]},{"runs":[{"text":"LOOP:\tA","sz":20.0},{"text":" \u2190","sz":20.0,"c":"#000000"},{"text":" A + B;","sz":20.0}]},{"runs":[{"text":"\t\tB","sz":20.0},{"text":" \u2190 ","sz":20.0,"c":"#000000"},{"text":"B - 1;","sz":20.0}]},{"runs":[{"text":"\t\tIf B< > 0 then go to LOOP;","sz":20.0}]},{"runs":[{"text":"\t\tC","sz":20.0},{"text":" \u2190 ","sz":20.0,"c":"#000000"},{"text":"A;","sz":20.0}]},{"runs":[{"text":"HALT:\tGo to HALT","sz":20.0}]},{"runs":[],"gap":1},{"runs":[{"text":"A. Design the processing section for implementing the above algorithm identifying all the control points. ","sz":20.0}]},{"runs":[{"text":"B. Draw a neat state diagram. Write the operations performed and the control signals to be activated in each state","sz":20.0}]},{"runs":[{"text":"C. Design controller using decoder, counter and sequence controller and draw the diagram ","sz":20.0}]},{"runs":[{"text":"D. Draw the PLA diagram for implementing the sequence controller","sz":20.0}]},{"runs":[{"text":"D. Design a Modern Microprogrammed control unit and give the binary listing of the microprogram","sz":20.0}]}],"anchor":"t"}]}]}