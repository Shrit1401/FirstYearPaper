gh knowledge about system architecture","sz":20.0,"c":"#000000"}]},{"runs":[{"text":"To speedup the development of \u00b5code, \u2192\u00b5assembly language.","sz":20.0,"c":"#000000"}]},{"runs":[{"text":"These \u00b5codes are held in CM. ","sz":20.0,"c":"#000000"}]}],"anchor":"t"},{"t":"img","box":[0.2185,0.4636,0.5047,0.3486],"src":"/dsco/slides/m7-l2/4.webp"}]},{"bg":null,"items":[{"t":"text","box":[-0.0,0.0007,1.0,0.2347],"paras":[{"runs":[{"text":"Design of Microprogrammed CU for 4X4 Booth\u2019s Multiplier","sz":40.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"8","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0312,0.0917,1.0,0.8159],"paras":[{"runs":[{"text":"STEP1: ","sz":18.0,"c":"#000000"},{"text":"Write \u00b5program in a symbolic form. (Symbolic micro program)","b":1,"c":"#000000","sz":18.0}]},{"runs":[{"text":"Control Mem ","sz":18.0,"b":1,"c":"#000000"},{"text":"Addr","sz":18.0,"b":1,"c":"#000000"},{"text":"\t\tControl Word","sz":18.0,"b":1,"c":"#000000"}]},{"runs":[{"text":"\t0\t\t\tSTART:  \tA\u21900, M \u2190 ","sz":18.0,"c":"#000000"},{"text":"Inbus","sz":18.0,"c":"#000000"},{"text":", L \u2190 4;\t\tC0, C1, C2\t","sz":18.0,"c":"#000000"}]},{"runs":[{"text":"\t1\t\t\t\tQ[4:1] \u2190 ","sz":18.0,"c":"#000000"},{"text":"Inbus","sz":18.0,"c":"#000000"},{"text":", Q[0] \u2190 0;\t\tC3","sz":18.0,"c":"#000000"}]},{"runs":[{"text":"\t2\t\t\tLOOP: \tIf Q[1:0]=01 then ","sz":18.0,"c":"#000000"},{"text":"goto","sz":18.0,"c":"#000000"},{"text":" ADD;","sz":18.0,"c":"#000000"}]},{"runs":[{"text":"\t3\t\t\t\tIf Q[1:0]=10 then ","sz":18.0,"c":"#000000"},{"text":"goto","sz":18.0,"c":"#000000"},{"text":" SUB;","sz":18.0,"c":"#000000"}]},{"runs":[{"text":"\t4\t\t\t\t","sz":18.0,"c":"#000000"},{"text":"goto","sz":18.0,"c":"#000000"},{"text":" RSHIFT;\t\t\t","sz":18.0,"c":"#000000"}]},{"runs":[{"text":"\t5\t\t\tADD:\tA \u2190 A+M;\t\t\tC4, C5","sz":18.0,"c":"#000000"}]},{"runs":[{"text":"\t6\t\t\t\t","sz":18.