{"id":"m7-l2","title":"Microprogrammed control unit","aspect":0.5625,"wpt":960,"slides":[{"bg":null,"items":[{"t":"text","box":[0.0437,0.3506,0.8098,0.2401],"paras":[{"runs":[{"text":"Microprogrammed control unit","sz":40.0}],"title":1}],"anchor":"ctr"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"1","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.1133,0.5853,0.7267,0.1032],"paras":[{"runs":[{"text":"Mohammed ","sz":20.0},{"text":"Rafiquzzaman","sz":20.0},{"text":" and Rajan Chandra, Modern Computer Architecture, ","sz":20.0},{"text":"Galgotia","sz":20.0},{"text":" Publications Pvt. Ltd., 2015.","sz":20.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0007,0.825,0.2347],"paras":[{"runs":[{"text":"Microprogrammed control unit","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0,0.1979,0.948,0.777],"paras":[{"runs":[{"text":"Control word: all control signals that can be simultaneously activated are grouped to form the CW.","sz":20.4}],"lvl":1,"align":"just","bullet":1},{"runs":[{"text":"Micro operation: A\u21900, ","sz":20.4},{"text":"outbus","sz":20.4},{"text":"=A, etc..","sz":20.4}],"lvl":1,"align":"just","bullet":1},{"runs":[{"text":"Each CW contains signals to activate one or more microoperations.","sz":20.4}],"lvl":1,"align":"just","bullet":1},{"runs":[{"text":"Control memory:","sz":20.4}],"lvl":1,"align":"just","bullet":1},{"runs":[{"text":"Control words are held in separate memory called control memory (CM).","sz":18.5}],"lvl":2,"align":"just","bullet":1},{"runs":[{"text":"Control words are fetched from CM and individual control fields are routed to various functional units to achieve desired task.","sz":20.4}],"lvl":2,"align":"just","bullet":1},{"runs":[{"text":"All microinstructions have 2 important fields:","sz":20.4}],"lvl":1,"align":"just","bullet":1},{"runs":[{"text":"Control field","sz":20.4}],"lvl":2,"align":"just","bullet":1},{"runs":[{"text":"Next  address field","sz":20.4}],"lvl":2,"align":"just","bullet":1},{"runs":[{"text":"Purpose of control field is to indicate which control lines are to be activated.","sz":20.4}],"lvl":1,"align":"just","bullet":1},{"runs":[{"text":"Purpose of Next address field is to specify the address of the next microinstruction to be executed.","sz":20.4}],"lvl":1,"align":"just","bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"2","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0007,0.8852,0.2347],"paras":[{"runs":[{"text":"Wilke\u2019s design of microprogrammed control unit","sz":40.0}],"title":1}],"anchor":"t"},{"t":"img","box":[0.2032,0.1919,0.6119,0.8074],"src":"/dsco/slides/m7-l2/1.webp"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"3","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[-0.0,0.0007,0.9689,0.2347],"paras":[{"runs":[{"text":"Architecture of modern microprogrammed control unit","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"4","sz":18.0}]}],"anchor":"t"},{"t":"text","box":[0.0,0.2687,0.8438,0.8159],"paras":[{"runs":[{"text":"Next address field from the \u00b5instruction can be eliminated. This pointer is referred as microprogram counter (MPC).","sz":24.0}]},{"runs":[{"text":"MPC is functionally identical to  PC.","sz":24.0}]},{"runs":[{"text":"It points to the \u00b5instruction to be executed next and incremented after each \u00b5instruction fetch.","sz":24.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[-0.0,0.0007,1.0,0.2347],"paras":[{"runs":[{"text":"General Purpose Microprogrammed Control Organization","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"5","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.1562,0.2142,0.6381,0.7631],"src":"/dsco/slides/m7-l2/2.webp"}]},{"bg":null,"items":[{"t":"text","box":[-0.0,0.0007,0.9689,0.2347],"paras":[{"runs":[