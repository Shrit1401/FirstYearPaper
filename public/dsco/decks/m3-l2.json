" ","sz":24.0,"b":1,"sub":1},{"text":"AeqB","sz":24.0,"sub":1},{"text":", ","sz":24.0,"sub":1},{"text":"AgtB","sz":24.0,"sub":1},{"text":", ","sz":24.0,"sub":1},{"text":"AltB","sz":24.0,"sub":1},{"text":";","sz":24.0,"sub":1}],"align":"just"},{"runs":[{"text":"always ","sz":24.0,"b":1,"sub":1},{"text":"@(A or B)","sz":24.0,"sub":1}],"align":"just"},{"runs":[{"text":"begin","sz":24.0,"b":1,"sub":1}],"align":"just"},{"runs":[{"text":"AeqB","sz":24.0,"sub":1},{"text":" = 0;","sz":24.0,"sub":1}],"align":"just"},{"runs":[{"text":"AgtB","sz":24.0,"sub":1},{"text":" = 0;","sz":24.0,"sub":1}],"align":"just"},{"runs":[{"text":"AltB","sz":24.0,"sub":1},{"text":" = 0;","sz":24.0,"sub":1}],"align":"just"},{"runs":[{"text":"if ","sz":24.0,"b":1,"sub":1},{"text":"(A == B)","sz":24.0,"sub":1}],"align":"just"},{"runs":[{"text":"AeqB","sz":24.0,"sub":1},{"text":" = 1;","sz":24.0,"sub":1}],"align":"just"},{"runs":[{"text":"else if ","sz":24.0,"b":1,"sub":1},{"text":"(A ","sz":24.0,"sub":1},{"text":"> ","sz":24.0,"i":1,"sub":1},{"text":"B)","sz":24.0,"sub":1}],"align":"just"},{"runs":[{"text":"AgtB","sz":24.0,"sub":1},{"text":" = 1;","sz":24.0,"sub":1}],"align":"just"},{"runs":[{"text":"else","sz":24.0,"b":1,"sub":1}],"align":"just"},{"runs":[{"text":"AltB","sz":24.0,"sub":1},{"text":" = 1;","sz":24.0,"sub":1}],"align":"just"},{"runs":[{"text":"end","sz":24.0,"b":1,"sub":1}],"align":"just"},{"runs":[{"text":"endmodule","sz":24.0,"b":1,"sub":1}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.1179,0.0957,0.7396,0.7136],"paras":[{"runs":[{"text":"Equality Operators","sz":24.0,"b":1,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"The expression (A == B) is evaluated as true if ","sz":24.0,"sub":1,"c":"#44546A"},{"text":"A ","sz":24.0,"i":1,"sub":1,"c":"#44546A"},{"text":"is equal to ","sz":24.0,"sub":1,"c":"#44546A"},{"text":"B ","sz":24.0,"i":1,"sub":1,"c":"#44546A"},{"text":"and false otherwise. ","sz":24.0,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"The","sz":24.0,"sub":1,"c":"#44546A"},{"text":" ","sz":24.0,"c":"#44546A"},{"text":"!= operator has the opposite effect. The result is ambiguous (","sz":24.0,"sub":1,"c":"#44546A"},{"text":"x","sz":24.0,"i":1,"sub":1,"c":"#44546A"},{"text":") if either operand contains","sz":24.0,"sub":1,"c":"#44546A"},{"text":" ","sz":24.0,"c":"#44546A"},{"text":"x ","sz":24.0,"i":1,"sub":1,"c":"#44546A"},{"text":"or ","sz":24.0,"sub":1,"c":"#44546A"},{"text":"z ","sz":24.0,"i":1,"sub":1,"c":"#44546A"},{"text":"values.","sz":24.0,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"Shift Operators","sz":24.0,"b":1,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"A vector operand can be shifted to the right or left by a number of bits specified as a","sz":24.0,"sub":1,"c":"#44546A"},{"text":" ","sz":24.0,"c":"#44546A"},{"text":"constant. When bits are shifted, the vacant bit positions are filled with 0s. For example,","sz":24.0,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"B =A","sz":24.0,"sub":1,"c":"#44546A"},{"text":"<< ","sz":24.0,"i":1,"sub":1,"c":"#44546A"},{"text":"1;","sz":24.0,"sub":1,"c":"#44546A"},{"text":" ","sz":24.0,"c":"#44546A"},{"text":"results in b2 = a1, b1 = a0, and b0 = 0. Similarly,","sz":24.0,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"B =A>> 2;  yields b2 = b1 = 0 and b0 = a2.","sz":24.0,"c":"#44546A"}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0933,0.0611,0.791,0.8213],"paras":[{"runs":[{"text":"Concatenate Operator","sz":24.0,"b":1,"c":"#44546A"}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"This operator concatenates two or more vectors to create a larger vector. For example,  D = {A, B};  defines the six-bit vector D = a2a1a0b2b1b0. Similarly, the concatenation  E = {3\u2019b111, A, 2\u2019b00};","sz":24.0,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"produces the eight-bit vector E = 111a","sz":24.0,"c":"#44546A"},{"text":"2","sz":24.0,"sub":1,"c":"#44546A"},{"text":"a","sz":24.0,"c":"#44546A"},{"text":"1","sz":24.0,"sub":1,"c":"#44546A"},{"text":"a","sz":24.0,"c":"#44546A"},{"text":"0","sz":24.0,"sub":1,"c":"#44546A"},{"text":"00.","sz":24.0,"c":"#44546A"}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"Replication Operator","sz":24.0,"b":1,"c":"#44546A"}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"This operator allows repetitive concatenation of the same vector, which is replicated the number of times indicated in the replication constant. For example, {3{A}} is equivalent to writing {A, A, A}. The specification {4{2\u2019b10}} produces the eight-bit vector 10101010.","sz":24.0,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"The replication operator may be used in conjunction with the concatenate operator. For instance, {2{A}, 3{B}} is equivalent to {A, A, B, B, B}.  ","sz":24.0,"c":"#44546A"}],"align":"just"}],"anchor":"t"}]}]}