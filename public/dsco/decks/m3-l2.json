{"id":"m3-l2","title":"Verilog for combinational circuits","aspect":0.5625,"wpt":960,"slides":[{"bg":null,"items":[{"t":"text","box":[0.0714,0.2555,0.8012,0.5161],"paras":[{"runs":[{"text":"Verilog provides ","sz":32.0},{"text":"procedural statements ","sz":32.0,"i":1},{"text":"(also called ","sz":32.0},{"text":"sequential statements","sz":32.0,"i":1},{"text":"). Whereas concurrent statements are executed in parallel, procedural statements are evaluated in the order in which they appear in the code. Verilog syntax requires that procedural statements be contained inside an ","sz":32.0},{"text":"always ","sz":32.0,"b":1},{"text":"block.","sz":32.0}],"align":"just"}],"anchor":"t"},{"t":"text","box":[0.3093,0.1027,0.3813,0.0853],"paras":[{"runs":[{"text":"Procedural Statements","sz":32.0,"b":1}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.332,0.0353,0.3701,0.0853],"paras":[{"runs":[{"text":"The Conditional Operator","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.1062,0.1538,0.8216,0.8303],"paras":[{"runs":[{"text":"conditional_expression","sz":28.0,"sub":1},{"text":" ? ","sz":28.0,"sub":1},{"text":"true_expression","sz":28.0,"sub":1},{"text":" : ","sz":28.0,"sub":1},{"text":"false_expression","sz":28.0,"sub":1}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"If the conditional expression evaluates to 1 (true), then the value of ","sz":28.0,"sub":1},{"text":"true_expression","sz":28.0,"sub":1},{"text":" is","sz":28.0,"sub":1},{"text":" ","sz":28.0},{"text":"chosen; otherwise, the value of ","sz":28.0,"sub":1},{"text":"false_expression","sz":28.0,"sub":1},{"text":" is chosen. ","sz":28.0,"sub":1}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"For example, the statement","sz":28.0,"sub":1},{"text":"      ","sz":28.0},{"text":"A= (B ","sz":28.0,"sub":1},{"text":"< ","sz":28.0,"i":1,"sub":1},{"text":"C) ? (D + 5) : (D + 2);","sz":28.0,"sub":1}],"align":"just"},{"runs":[{"text":"means that if B is less than C, the value of A will be D + 5 or else A will have the value D+2. ","sz":28.0}],"align":"just"},{"runs":[],"gap":1},{"runs":[{"text":"Parentheses are not necessary. The conditional operator can be used both in continuous assignment statements and in procedural statements inside an always block.","sz":28.0}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.2545,0.0779,0.5,0.3276],"paras":[{"runs":[{"text":"module ","sz":28.0,"b":1,"sub":1},{"text":"mux2to1 (w0, w1, s, f);","sz":28.0,"sub":1}],"align":"just"},{"runs":[{"text":"input ","sz":28.0,"b":1,"sub":1},{"text":"w0, w1, s;","sz":28.0,"sub":1}],"align":"just"},{"runs":[{"text":"output ","sz":28.0,"b":1,"sub":1},{"text":"f;","sz":28.0,"sub":1}],"align":"just"},{"runs":[{"text":"assign ","sz":28.0,"b":1,"sub":1},{"text":"f = s ? w1 : w0;","sz":28.0,"sub":1}],"align":"just"},{"runs":[{"text":"endmodule","sz":28.0,"b":1,"sub":1}],"align":"just"}],"anchor":"t"},{"t":"text","box":[0.2545,0.4713,0.5,0.4533],"paras":[{"runs":[{"text":"module ","sz":28.0,"b":1,"sub":1,"c":"#44546A"},{"text":"mux2to1 (w0, w1, s, f);","sz":28.0,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"input ","sz":28.0,"b":1,"sub":1,"c":"#44546A"},{"text":"w0, w1, s;","sz":28.0,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"output ","sz":28.0,"b":1,"sub":1,"c":"#44546A"},{"text":"f;","sz":28.0,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"reg","sz":28.0,"b":1,"sub":1,"c":"#44546A"},{"text":" ","sz":28.0,"b":1,"sub":1,"c":"#44546A"},{"text":"f;","sz":28.0,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"always ","sz":28.0,"b":1,"sub":1,"c":"#44546A"},{"text":"@(w0 or w1 or s)","sz":28.0,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"f = s ? w1 : w0;","sz":28.0,"sub":1,"c":"#44546A"}],"align":"just"},{"runs":[{"text":"endmodule","sz":28.0,"b":1,"sub":1,"c":"#44546A"}],"align":"just"}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.1246,0.201,0.6948,0.3904],"paras":[{"runs":[{"text":"module ","sz