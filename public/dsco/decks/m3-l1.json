text":"1","sz":24.0,"sub":1},{"text":"w","sz":24.0},{"text":"0","sz":24.0,"sub":1},{"text":" determines which of the outputs is asserted.","sz":24.0}],"bullet":1},{"runs":[{"text":"If ","sz":24.0},{"text":"En","sz":24.0,"i":1},{"text":"=0, then none of the decoder outputs is asserted.","sz":24.0}],"bullet":1}],"anchor":"t"},{"t":"img","box":[0.0307,0.5638,0.9178,0.1496],"src":"/dsco/slides/m3-l1/26.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.024,0.022,0.9312,0.0853],"paras":[{"runs":[{"text":"2-to-4 Decoders","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"img","box":[0.1668,0.2356,0.7075,0.5613],"src":"/dsco/slides/m3-l1/27.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.024,0.022,0.9312,0.0853],"paras":[{"runs":[{"text":"2-to-4 Decoders","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"img","box":[0.2351,0.1073,0.4366,0.7929],"src":"/dsco/slides/m3-l1/28.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.024,0.022,0.9312,0.0853],"paras":[{"runs":[{"text":"Decoders","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"img","box":[0.2545,0.2229,0.5034,0.5681],"src":"/dsco/slides/m3-l1/29.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0168,-0.0029,0.9312,0.0853],"paras":[{"runs":[{"text":"Decoders","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"text","box":[0.0168,0.0696,0.9454,0.1212],"paras":[{"runs":[{"text":"Larger decoders can be built using the sum-of-products structure or else they can be constructed from smaller decoders. ","sz":24.0,"i":1}]}],"anchor":"t"},{"t":"img","box":[0.2519,0.1908,0.5808,0.6475],"src":"/dsco/slides/m3-l1/30.webp"},{"t":"img","box":[0.2351,0.852,0.5799,0.0998],"src":"/dsco/slides/m3-l1/31.webp"},{"t":"text","box":[0.0097,0.9318,0.9454,0.0673],"paras":[{"runs":[{"text":"The w2 input drives the enable input of the two decoders.","sz":24.0,"i":1}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0168,-0.0029,0.9312,0.0853],"paras":[{"runs":[{"text":"4-to-16 Decoder","sz":32.0,"b":1}]}],"anchor":"t"},{"t":"img","box":[0.4914,0.0397,0.4438,0.9234],"src":"/d