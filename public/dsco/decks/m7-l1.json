t"},{"t":"text","box":[0.0294,0.1623,0.932,0.7931],"paras":[{"runs":[{"text":"The other register transfer operations are","sz":24.0}],"bullet":1},{"runs":[{"text":"D","sz":24.0},{"text":"\u2190A\u2019;        \tTransfer the complement of A to D.","sz":24.0}],"bullet":1},{"runs":[{"text":"A","sz":24.0},{"text":"\u2190 A+1;    \tIncrement the content of A by 1.","sz":24.0}],"bullet":1},{"runs":[{"text":"A","sz":24.0},{"text":"\u2190 A-1;     \tDecrement the content of A by 1.","sz":24.0}],"bullet":1},{"runs":[{"text":"D","sz":24.0},{"text":"\u2190 A V B;    \tA OR B, store result in D","sz":24.0}],"bullet":1},{"runs":[{"text":"D\u2190 A \u0245 B;    \tA AND B, store result in D","sz":24.0}],"bullet":1},{"runs":[{"text":"LSR(A);        \tLogical shift right","sz":24.0}],"bullet":1},{"runs":[{"text":"ASR(A);        \tArithmetic shift right","sz":24.0}],"bullet":1},{"runs":[{"text":"LSL, ASL, ROR, ROL","sz":24.0}],"bullet":1},{"runs":[{"text":"A$Q \u2013 used to concatenate  A and Q","sz":24.0}],"bullet":1},{"runs":[{"text":"ASR(A$Q) ;","sz":24.0}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"8","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.1236,0.3506,0.7997,0.2401],"paras":[{"runs":[{"text":"HARDWIRED APPROACH","sz":40.0}],"title":1}],"anchor":"ctr"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"9","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"HARDWIRED APPROACH","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0147,0.2036,0.8213,0.6511],"paras":[{"runs":[{"text":"Control logic is a clocked sequential circuit.","sz":24.0}],"bullet":1},{"runs":[{"text":"So conventional sequential circuit design procedure can be applied to build CU.","sz":24.0}],"bullet":1},{"runs":[{"text":"Final circuit is obtained by physically connecting gates and flip flops.","sz":24.0}],"bullet":1},{"runs":[{"text":"Cost of control logic increases with system complexity.","sz":24.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"10","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"10 steps for hardwired control","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0147,0.2036,0.8558,0.7942],"paras":[{"runs":[{"text":"Define task to be performed.","sz":20.0}],"bullet":1},{"runs":[{"text":"Propose a trial processing section.","sz":20.0}],"bullet":1},{"runs":[{"text":"Provide a register  transfer description  algorithm based on processing section outlined.","sz":20.0}],"bullet":1},{"runs":[{"text":"Validate the algorithm by using trial data.","sz":20.0}],"bullet":1},{"runs":[{"text":"Describe the basic characteristics of the hardware elements to be used in the processing section.","sz":20.0}],"bullet":1},{"runs":[{"text":"Complete the design of the processing section by establishing necessary control points.","sz":20.0}],"bullet":1},{"runs":[{"text":"Propose the block diagram of the controller.","sz":20.0}],"bullet":1},{"runs":[{"text":"Specify state diagram of controller.","sz":20.0}],"bullet":1},{"runs":[{"text":"Specify the characteristics of the hardware elements to be used in the controller.","sz":20.0}],"bullet":1},{"runs":[{"text":"Complete the controller design and draw a logic diagram of final circuit.","sz":20.0}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"11","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"10 steps for hardwired control","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0147,0.2036,0.8558,0.7942],"paras":[{"runs":[{"text":"Step 1:","sz":24.0,"b":1},{"text":" Task definition.","sz":24.0}]},{"runs":[{"text":"Design a Booth\u2019s multiplier to multiply two 4-bit signe