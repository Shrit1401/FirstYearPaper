{"id":"m7-l1","title":"Hardwired control unit","aspect":0.5625,"wpt":960,"slides":[{"bg":null,"items":[{"t":"text","box":[0.1289,0.2337,0.7051,0.2663],"paras":[{"runs":[{"text":"Control Unit","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.1133,0.5853,0.7267,0.1032],"paras":[{"runs":[{"text":"Mohammed ","sz":20.0},{"text":"Rafiquzzaman","sz":20.0},{"text":" and Rajan Chandra, Modern Computer Architecture, ","sz":20.0},{"text":"Galgotia","sz":20.0},{"text":" Publications Pvt. Ltd., 2015.","sz":20.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Control Unit","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.015,0.2047,0.932,0.7931],"paras":[{"runs":[{"text":"Basic concepts","sz":24.0,"b":1}],"bullet":1},{"runs":[{"text":"Fundamentals of Control Unit","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Register transfer notations and descriptions","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Buses ","sz":24.0}],"lvl":1,"bullet":1},{"runs":[],"gap":1},{"runs":[{"text":"Design methods","sz":24.0,"b":1}],"bullet":1},{"runs":[{"text":"Hardwired approach","sz":24.0}],"lvl":1,"bullet":1},{"runs":[{"text":"Microprogramming ","sz":24.0}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"2","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Introduction","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.015,0.2047,0.932,0.7931],"paras":[{"runs":[{"text":"CPU is viewed as a collection of two major components:","sz":24.0}],"bullet":1},{"runs":[{"text":"Processing section","sz":24.0}],"bullet":1},{"runs":[{"text":"Control Unit","sz":24.0}],"bullet":1},{"runs":[{"text":"Control unit\u2019s responsibility is to drive the associated processing hardware by generating a set of signals that are synchronized with the ","sz":24.0,"sub":1,"c":"#000000"},{"text":"master clock.","sz":24.0,"sub":1,"c":"#FF0000"}],"bullet":1},{"runs":[{"text":"In order to carry out a task, the CU must generate a set of control signals in a ","sz":24.0,"sub":1,"c":"#000000"},{"text":"predefined sequence","sz":24.0,"sub":1,"c":"#FF0000"},{"text":" governed by the hardware structure of the processing section.","sz":24.0,"sub":1,"c":"#000000"}],"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"3","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Introduction (Contd.)","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.015,0.2047,0.932,0.7931],"paras":[{"runs":[{"text":"Inputs to CU are:","sz":24.0,"sub":1,"c":"#000000"}],"bullet":1},{"runs":[{"text":"Master clock","sz":24.0,"sub":1,"c":"#000000"}],"lvl":1,"bullet":1},{"runs":[{"text":"Status information  from processing section","sz":24.0,"sub":1,"c":"#000000"}],"lvl":1,"bullet":1},{"runs":[{"text":"Command signals from external agent (like RESET,","sz":24.0,"sub":1,"c":"#000000"},{"text":" ABORT)","sz":24.0,"c":"#000000"}],"lvl":1,"bullet":1},{"runs":[{"text":"Outputs produced by CU","sz":24.0,"sub":1,"c":"#000000"}],"bullet":1},{"runs":[{"text":"Signals that drive the processing section and responses to an external environment.","sz":24.0,"sub":1,"c":"#000000"}],"lvl":1,"bullet":1},{"runs":[{"text":"Control unit undertakes the following responsibilities:","sz":24.0,"sub":1,"c":"#000000"}],"bullet":1},{"runs":[{"text":"Instruction interpretation: ","sz":24.0,"b":1,"sub":1,"c":"#000000"},{"text":"(CU read instructions, recognizes the instruction type, gets  operands and route to appropriate functional units of Processing Unit (PU), necessary control signals are then issued to the PU to perform desired operation)","sz":24.0,"sub":1,"c":"#000000"}],"lvl":1,"bullet":1},{"runs":[{"text":"Instruction sequencing:","sz":24.0,"b":1,"sub":1,"c":"#000000"},{"text":" CU determines the address of next instruction to be executed and loads it ","sz":24.0,"sub":1,"c":"#000000"},{"text":"on ","sz":24.0,"c":"#000000"},{"text":"to PC.","sz":24.0,"sub":1,"c":"#000000"}],"lvl":1,"bullet":1}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"4","sz":18.0}]}],"anchor":"t"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Basic","sz":44.0},{"text":" ","sz":44.0,"b":1},{"text":"Concepts","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.015,0.1955,0.8359,0.7931],"paras":[{"runs":[{"text":"Basis for CU design are register transfer operations","sz":20.0,"sub":1,"c":"#000000"}],"bullet":1},{"runs":[{"text":"8-bit info moved from Register A to Register B.","sz":20.0,"sub":1,"c":"#000000"}],"lvl":1,"bullet":1},{"runs":[{"text":"Such operation is described as B","sz":20.0,"sub":1,"c":"#000000"},{"text":"\u2190","sz":20.0,"sub":1,"c":"#000000"},{"text":"A","sz":20.0,"sub":1,"c":"#000000"}],"lvl":2,"bullet":1},{"runs":[{"text":"Declaring registers:\tDeclare registers A[8], B[8], PC[16] ;","sz":20.0,"sub":1,"c":"#000000"}],"lvl":2,"bullet":1},{"runs":[{"text":"Register can be defined as a portion of some other register.","sz":20.0,"sub":1,"c":"#000000"}],"lvl":1,"bullet":1},{"runs":[{"text":"Assigning higher order byte of 16-bit PC: Declare ","sz":20.0,"sub":1,"c":"#000000"},{"text":"subregisters","sz":20.0,"sub":1,"c":"#000000"},{"text":" PCHI[8]= PC[15-8] ;","sz":20.0,"sub":1,"c":"#000000"}],"lvl":2,"bullet":1},{"runs":[{"text":"Assigning individual bits","sz":20.0,"sub":1,"c":"#000000"}],"lvl":1,"bullet":1},{"runs":[{"text":"B[0]","sz":20.0,"sub":1,"c":"#000000"},{"text":" \u2190 ","sz":20.0,"c":"#000000"},{"text":"A[7] means MSB of A is copied to LSB of B.","sz":20.0,"sub":1,"c":"#000000"}],"lvl":2,"bullet":1},{"runs":[{"text":"Normally two i","sz":20.0,"sub":1,"c":"#000000"},{"text":"nput","sz":20.0,"c":"#000000"},{"text":"s are associated with each register:","sz":20.0,"sub":1,"c":"#000000"}],"lvl":1,"bullet":1},{"runs":[{"text":"Enable  ","sz":20.0,"sub":1,"c":"#000000"},{"text":"i","sz":20.0,"sub":1,"c":"#000000"},{"text":"n","sz":20.0,"c":"#000000"},{"text":"put (E) or control input controls the data flow from A to B","sz":20.0,"sub":1,"c":"#000000"}],"lvl":2,"bullet":1},{"runs":[{"text":"Data i","sz":20.0,"sub":1,"c":"#000000"},{"text":"nput","sz":20.0,"c":"#000000"}],"lvl":2,"bullet":1},{"runs":[{"text":"Register B is loaded with A only when E is held high else contents of register remain the same. ","sz":20.0,"sub":1,"c":"#000000"}],"lvl":2},{"runs":[{"text":"Such conditional transfer is expressed as ","sz":20.0,"sub":1,"c":"#000000"}],"lvl":2},{"runs":[{"text":"\t\t\tE: B","sz":20.0,"sub":1,"c":"#000000"},{"text":"\u2190","sz":20.0,"sub":1,"c":"#000000"},{"text":"A","sz":20.0,"sub":1,"c":"#000000"}],"lvl":2}],"anchor":"t"},{"t":"text","box":[0.7046,0.8809,0.056,0.0532],"paras":[{"runs":[{"text":"5","sz":18.0}]}],"anchor":"t"},{"t":"img","box":[0.8731,0.1985,0.1269,0.2631],"src":"/dsco/slides/m7-l1/1.webp","crop":[0.33598,0.30759,0.0,0.13871]},{"t":"img","box":[0.81,0.5576,0.1923,0.2903],"src":"/dsco/slides/m7-l1/2.webp"}]},{"bg":null,"items":[{"t":"text","box":[0.0,0.0022,0.9615,0.2347],"paras":[{"runs":[{"text":"Basic","sz":44.0},{"text":" ","sz":44.0,"b":1},{"text":"Concepts (Contd.)","sz":44.0}],"title":1}],"anchor":"t"},{"t":"text","box":[0.0147,0.2069,0.932,0.7931],"paras":[{"runs":[{"text":"Control input can be a function of more than one variable.","sz":20.0}],"bullet":1},{"runs":[{"text":"\t","sz":20.0},{"text":"IF A>B and D[0]=0 THEN A","sz":20.0},{"text":"\u2190B","sz":20.0}]},{"runs":[{"text":"Compa","sz":20.0,"sub":1,"c":"#000000"},{"text":"rator","sz":20.0,"c":"#000000"},{"text":" : if A>B, the output G from the comparator is set to high","sz":20.0,"c":"#000000"}],"lvl":1,"bullet":1},{"runs":[{"text":"Conditional transfer: C","sz":20.0,"sub":1,"c":"#000000"},{"text":"0","sz":20.0,"sub":1,"c":"#000000"},{"text":