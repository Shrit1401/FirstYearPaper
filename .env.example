# Convex (created by `npx convex dev`; the deployment stores auth keys and Dodo secrets)
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Repeat 2.0 teacher (server only, never NEXT_PUBLIC_)
OPENAI_API_KEY=sk-...
# REPEAT_SOLVE_MODEL=gpt-5.4-mini
# REPEAT_SOLVE_REASONING=high

# Shared rate limiting (recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog browser analytics (US Cloud project 575638).
# Set BOTH values in the hosting provider Production environment before building.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Owner analytics dashboard gate
REPEAT_ANALYTICS_SECRET=

# Local original scans. Vercel uses its static deployment URL instead.
REPEAT_LOCAL_ASSET_ROOT=public/repeat-v2/assets

# Set these on the Convex deployment, not here:
#   npx convex env set SITE_URL=https://paper.shrit.in
#   npx convex env set DODO_PAYMENTS_API_KEY=...
#   npx convex env set DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
#   npx convex env set DODO_PRODUCT_ID=pdt_...
#   npx convex env set DODO_ENVIRONMENT=live_mode   # or test_mode
# JWT_PRIVATE_KEY and JWKS come from `npm run convex:setup-auth`.
